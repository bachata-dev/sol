// The footer's understudy. The strip itself is sol-footer now — one surface
// holding both the status line and the command line — and this waybar is
// what sol-footer execs on a machine without GTK, so the bottom edge is
// never simply missing. Same grammar as the header, turned upside down:
// where the top bar says where you are, this one says what you just did.
//
// Idle it is a status line. Press mod+; and a command line opens over it,
// takes any sol command with tab completion, and closes again.
//
// It asks driftwm nothing: both modules read the file `sol here` already
// leaves behind for the header.
{
  "layer": "top",
  "position": "bottom",
  "height": 28,
  "modules-left": ["custom/prompt"],
  "modules-right": ["custom/last"],

  "custom/prompt": {
    "format": "☉ ▸",
    "on-click": "sol-footer toggle",
    "tooltip": false
  },

  // Signalled by `sol watch` along with the rest of the bar, and reading the
  // same file — a sed rather than a Python interpreter, and only when there
  // is something new to say. This line changes more often than the others
  // (it counts the seconds since sol last did something), which is exactly
  // why it should not have been the one polling hardest.
  "custom/last": {
    "exec": "sed -n 4p $XDG_RUNTIME_DIR/sol-bar",
    "return-type": "json",
    // Its own signal: this line ticks every second while the footer is
    // counting, and waking the other eleven modules to watch it do that was
    // twenty-two processes a second of nothing happening.
    "signal": 9,
    "interval": 60,
    "on-click": "sol-footer toggle"
  }
}
