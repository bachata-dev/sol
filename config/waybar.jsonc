// The bar, in the grammar of the macOS menu bar — because the mapping is
// exact. There, the frontmost application owns the left of the bar: its name
// in bold, then its menus. Here, the planet you are standing on is the
// frontmost application, so it gets the same place and the same weight.
//
//   ☉          where  would be, holding what  holds: the machine
//   Earth      the "app": where you are, in bold, in its own colour
//   home · 10  its "menus": the role it plays and what it is holding
//   ①②❸④┊⑤⑥⑦⑧  the strip — all eight planets, and who is holding what
//   status     monochrome, quiet, evenly spaced
//   ▦          Control Centre: opens the overview (mod+e)
//   clock      last, as it is on every Mac
//
// Only `custom/where` talks to driftwm. It leaves the other two modules'
// JSON in $XDG_RUNTIME_DIR/sol-bar, so they cost a seek and a print.
{
  "layer": "top",
  "position": "top",
  "height": 28,
  "modules-left": ["custom/sol", "custom/where", "custom/holding"],
  "modules-center": ["custom/p1", "custom/p2", "custom/p3", "custom/p4",
                     "custom/belt",
                     "custom/p5", "custom/p6", "custom/p7", "custom/p8"],
  "modules-right": ["cpu", "memory", "pulseaudio", "network", "tray", "custom/overview", "clock"],

  // The ☉ sits where  sits, so it opens what  opens: lock, sleep,
  // restart, shut down, log out — the machine, not the canvas. Right-click
  // it for the canvas menu, which is also what right-clicking the sky gives.
  "custom/sol": {
    "format": "☉",
    "on-click": "sol menu system",
    "on-click-right": "sol menu here",
    "tooltip": false
  },

  // Nothing here asks driftwm anything, and nothing here polls. `sol watch`
  // is subscribed to the compositor already, so it writes $XDG_RUNTIME_DIR/
  // sol-bar when the world moves and sends SIGRTMIN+8; every module below
  // reads its own line out of that file when tapped, and sleeps otherwise.
  // The interval is a safety net, not a heartbeat: if a signal is ever
  // missed, or sol watch is not running, the bar still catches up.
  "custom/where": {
    "exec": "sed -n 1p $XDG_RUNTIME_DIR/sol-bar",
    "return-type": "json",
    "signal": 8,
    "interval": 60,
    "on-click": "sol system",
    "on-click-right": "sol menu here"
  },
  "custom/holding": {
    "exec": "sed -n 2p $XDG_RUNTIME_DIR/sol-bar",
    "return-type": "json",
    "signal": 8,
    "interval": 60,
    "on-click": "sol arrange",
    "on-click-right": "sol-map"
  },

  // The strip is eight buttons, not one readout — because the muscle memory
  // for "click a number, be on that workspace" lives in the bar, and nowhere
  // else. Each chip reads its line straight out of the file `sol here`
  // leaves behind (a sed, not an interpreter), flies you there on click, and
  // still hops sunward / outward under the scroll wheel. Signalled, like
  // everything else on this bar.
  "custom/p1": { "exec": "sed -n 5p $XDG_RUNTIME_DIR/sol-bar", "return-type": "json", "signal": 8, "interval": 60,
                 "on-click": "sol goto 1", "on-scroll-up": "sol hop in", "on-scroll-down": "sol hop out" },
  "custom/p2": { "exec": "sed -n 6p $XDG_RUNTIME_DIR/sol-bar", "return-type": "json", "signal": 8, "interval": 60,
                 "on-click": "sol goto 2", "on-scroll-up": "sol hop in", "on-scroll-down": "sol hop out" },
  "custom/p3": { "exec": "sed -n 7p $XDG_RUNTIME_DIR/sol-bar", "return-type": "json", "signal": 8, "interval": 60,
                 "on-click": "sol goto 3", "on-scroll-up": "sol hop in", "on-scroll-down": "sol hop out" },
  "custom/p4": { "exec": "sed -n 8p $XDG_RUNTIME_DIR/sol-bar", "return-type": "json", "signal": 8, "interval": 60,
                 "on-click": "sol goto 4", "on-scroll-up": "sol hop in", "on-scroll-down": "sol hop out" },
  "custom/belt": { "format": "┊", "tooltip": false },
  "custom/p5": { "exec": "sed -n 9p $XDG_RUNTIME_DIR/sol-bar", "return-type": "json", "signal": 8, "interval": 60,
                 "on-click": "sol goto 5", "on-scroll-up": "sol hop in", "on-scroll-down": "sol hop out" },
  "custom/p6": { "exec": "sed -n 10p $XDG_RUNTIME_DIR/sol-bar", "return-type": "json", "signal": 8, "interval": 60,
                 "on-click": "sol goto 6", "on-scroll-up": "sol hop in", "on-scroll-down": "sol hop out" },
  "custom/p7": { "exec": "sed -n 11p $XDG_RUNTIME_DIR/sol-bar", "return-type": "json", "signal": 8, "interval": 60,
                 "on-click": "sol goto 7", "on-scroll-up": "sol hop in", "on-scroll-down": "sol hop out" },
  "custom/p8": { "exec": "sed -n 12p $XDG_RUNTIME_DIR/sol-bar", "return-type": "json", "signal": 8, "interval": 60,
                 "on-click": "sol goto 8", "on-scroll-up": "sol hop in", "on-scroll-down": "sol hop out" },

  "custom/overview": {
    "format": "▦",
    "on-click": "sol-map",
    "tooltip": false
  },

  // Percentages, because a bare number in a menu bar is just noise.
  "cpu": {
    "format": "{usage}%",
    "interval": 3,
    "tooltip": false
  },
  "memory": {
    "format": "{percentage}%",
    "interval": 5,
    "tooltip": false
  },
  // Glyphs are named literally rather than through format-icons, and only
  // ones this Nerd Font actually carries — a missing icon is worse than none.
  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  mute",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
    "tooltip": false
  },
  // Connected says it in one glyph; losing the route is the only thing
  // here worth a word, so that is the only case that gets one.
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "offline",
    "interval": 10,
    "tooltip-format-wifi": "{essid} · {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "tooltip-format-disconnected": "no route"
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}
