#!/bin/bash
# Orbital window cycling: focus the next/prev window in angular order around
# Sol (the Desk origin), like hopping planet-to-planet. Long hops fly an arc
# (zoom out, glide, zoom in). Usage: driftwm-orbit next|prev

DIR="${1:-next}"
S=$(timeout 3 driftwm msg state 2>/dev/null) || exit 1

read -r TARGET TX TY <<< "$(awk -v dir="$DIR" '
  /^camera /    { cx = $2; cy = $3 }
  /^windows /   { inwin = 1; next }
  /^fullscreen/ { inwin = 0 }
  inwin && /#[0-9]+ / {
    id = ""; app = ""; x = ""; y = ""
    for (i = 1; i <= NF; i++) {
      if ($i ~ /^#[0-9]+$/) { id = substr($i, 2); app = $(i + 1) }
      if ($i ~ /^\[/) { x = $i; y = $(i + 1) }
    }
    if (id == "" || app ~ /region-label|astrolabe/) next
    gsub(/[\[,]/, "", x); gsub(/[\],]/, "", y)
    n++
    ids[n] = id; xs[n] = x + 0; ys[n] = y + 0
    ang[n] = atan2(y + 0, x + 0)
    if ($1 == "*") cur = id
  }
  END {
    if (n == 0) exit 1
    for (i = 2; i <= n; i++) {
      a = ang[i]; d = ids[i]; xx = xs[i]; yy = ys[i]
      for (j = i - 1; j >= 1 && ang[j] > a; j--) {
        ang[j+1] = ang[j]; ids[j+1] = ids[j]; xs[j+1] = xs[j]; ys[j+1] = ys[j]
      }
      ang[j+1] = a; ids[j+1] = d; xs[j+1] = xx; ys[j+1] = yy
    }
    ci = 1
    for (i = 1; i <= n; i++) if (ids[i] == cur) ci = i
    if (dir == "next") ni = (ci % n) + 1; else ni = ((ci - 2 + n) % n) + 1
    print ids[ni], xs[ni], ys[ni]
  }' <<< "$S")"

[ -z "$TARGET" ] && exit 1

CAM=$(driftwm msg camera | awk '{print $(NF-1), $NF}')
FAR=$(awk -v c="$CAM" -v tx="$TX" -v ty="$TY" 'BEGIN {
  split(c, a, " ")
  print (sqrt((a[1]-tx)^2 + (a[2]-ty)^2) > 1500) ? 1 : 0
}')

if [ "$FAR" = 1 ]; then
  driftwm msg zoom 0.55 > /dev/null 2>&1
  sleep 0.28
  driftwm msg focus --id "$TARGET" > /dev/null 2>&1
  sleep 0.4
  exec driftwm msg action center-window > /dev/null 2>&1
else
  driftwm msg focus --id "$TARGET" > /dev/null 2>&1
  exec driftwm msg action center-window > /dev/null 2>&1
fi
