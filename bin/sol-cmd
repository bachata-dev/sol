#!/bin/bash
# Open sol's command line — which is the footer itself now.
#
# The strip along the bottom holds both registers: at rest it reports, and
# addressed it listens. sol-footer owns the surface; this just knocks. The
# name is kept because a keybinding, the bar's on-click and a README all
# learned it — and on a machine without GTK, sol-footer's knock falls back
# to the one-line foot terminal this script used to spawn.

exec sol-footer toggle
