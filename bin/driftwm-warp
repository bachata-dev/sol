#!/bin/bash
# Warp menu — fly the camera to a universe region (fuzzel dmenu).
# Long hops fly a Google-Earth-style arc: zoom out, glide, zoom back in.
# "Universe" = zoom-to-fit windows; "Cosmos" = frame the whole known universe.

R="$HOME/.config/driftwm/regions.tsv"
CH=$( (printf 'Universe\nCosmos\n'; cut -f1 "$R") | fuzzel --dmenu --prompt "warp ▸ " --lines 8) || exit 0
[ -z "$CH" ] && exit 0

case "$CH" in
  Universe)
    exec driftwm msg action zoom-to-fit ;;
  Cosmos)
    driftwm msg zoom 0.18 > /dev/null
    exec driftwm msg camera 0 0 ;;
esac

L=$(awk -F'\t' -v n="$CH" '$1 == n { print $2, $3 }' "$R")
[ -z "$L" ] && exit 1

CAM=$(driftwm msg camera | awk '{print $(NF-1), $NF}')
FAR=$(awk -v c="$CAM" -v l="$L" 'BEGIN {
  split(c, a, " "); split(l, b, " ")
  print (sqrt((a[1]-b[1])^2 + (a[2]-b[2])^2) > 1500) ? 1 : 0
}')

if [ "$FAR" = 1 ]; then
  driftwm msg zoom 0.5 > /dev/null
  sleep 0.3
  driftwm msg camera $L > /dev/null
  sleep 0.35
  exec driftwm msg zoom 1 > /dev/null
else
  driftwm msg zoom 1 > /dev/null
  exec driftwm msg camera $L
fi
