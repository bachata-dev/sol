#!/usr/bin/env python3
"""sol — navigate the driftwm canvas as our solar system.

The canvas is a heliocentric map: the Sun sits at the origin and the eight
planets sit where they really are on the date the layout was generated, each
on its own ellipse, ordered outward exactly as everyone learned them. Distance
from the Sun is distance from your attention: inner planets are immediate,
the asteroid belt divides, outer planets are background.

Every window belongs to a place — where you sent it, or failing that whatever
it is nearest. That district is what lets `sol` answer "what is on Earth?":
it can frame the district, tidy it into a grid, count it on the map, and step
through it one window at a time.

Everything here talks to driftwm over its JSON IPC socket. All camera motion
goes through fly(), which interpolates position and zoom at 90 Hz with an
ease-in-out curve — so the view always travels, and never jumps.

  sol goto <name|number|sun>   fly to a planet; again to dive into its windows
  sol hop <in|out>             fly to the next planet sunward / outward
  sol system                   frame the whole solar system
  sol arrange [where|all]      tidy a planet's windows into a grid
  sol next / sol prev          step through the windows of this planet
  sol send <name|number>       send the focused window to a planet
  sol list                     what is where
  sol here [--waybar]          where am I?
  sol menu                     fuzzel warp menu
  sol map                      the overview (runs inside a terminal)
  sol bar <where|holding|strip>  one line of the bar
  sol help [--hold]            keybinding card
"""

import glob
import json
import math
import os
import socket
import sys
import time
from collections import namedtuple

# ── The solar system ──────────────────────────────────────────────────────
# Canvas coordinates (Y-up), from the real sky for 2026-07-30: each planet is
# placed by solving Kepler's equation, so it sits on its own ellipse at the
# angle it really occupied. Orbits keep their real eccentricity and perihelion
# direction — the Sun is at a focus, not the centre — while the semi-major
# axes are spaced uniformly, so every hop is a comparable distance.
# Regenerate for another date with tools/sol-positions.py.
Planet = namedtuple("Planet", "n name x y a e peri body colour role")
#             n  name        x      y     a   ecc     perihelion° body  colour   role
PLANETS = [
    Planet(1, "Mercury",   934,  -141, 1000, 0.20564,   77.50,  76, "#9aa5ce", "quick"),
    Planet(2, "Venus",    -512, -1753, 1820, 0.00677,  131.60, 103, "#e0af68", "comms"),
    Planet(3, "Earth",    1595, -2154, 2640, 0.01670,  103.02, 105, "#7aa2f7", "home"),
    Planet(4, "Mars",     2057,  2649, 3460, 0.09342,  -23.83,  85, "#f7768e", "ops"),
    Planet(5, "Jupiter", -2561,  3512, 4280, 0.04835,   14.78, 233, "#ff9e64", "builds"),
    Planet(6, "Saturn",   4997,   768, 5100, 0.05373,   92.49, 220, "#e6cfa1", "media"),
    Planet(7, "Uranus",   2823,  5294, 5920, 0.04725,  171.06, 166, "#7dcfff", "spare"),
    Planet(8, "Neptune",  6692,   265, 6740, 0.00860,   44.88, 165, "#5a7fd0", "archive"),
]
SUN = Planet(0, "Sun", 0, 0, 0, 0.0, 0.0, 502, "#f0d99a", "home base")
PLACES = [SUN] + PLANETS
BELT_R = 3870          # asteroid belt radius, between Mars and Jupiter
SYSTEM_R = 6800        # outermost orbit, at aphelion

WORK_ZOOM = 1.0
ARRIVE_RADIUS = 900    # how close counts as "on" a planet
DISTRICT = 2600        # how far a window can sit and still belong to a planet
MIN_FRAME_ZOOM = 0.16  # never pull back further than this to frame a district
GAP = 90               # breathing room between tidied windows
PLATE_GAP = 40         # and between the top of a district and its name plate
DIM = 0.90             # unfocused windows, so the focused one stands forward
CARD_PAD = 70          # margin of the card a district sits on
SHADER = os.path.expanduser("~/.config/driftwm/sol.glsl")
FUZZEL = os.path.expanduser("~/.config/driftwm/fuzzel.ini")


# ── IPC ───────────────────────────────────────────────────────────────────
class Drift:
    def __init__(self):
        socks = sorted(glob.glob("/run/user/*/driftwm/ipc-*.sock"))
        env = os.environ.get("DRIFTWM_SOCKET")
        path = env if env else (socks[0] if socks else None)
        if not path:
            sys.exit("sol: driftwm is not running (no IPC socket found)")
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s.settimeout(3)
        self.s.connect(path)
        self.f = self.s.makefile("rwb")

    def req(self, obj):
        self.f.write((json.dumps(obj) + "\n").encode())
        self.f.flush()
        line = self.f.readline().decode().strip()
        if not line:
            return None
        r = json.loads(line)
        return r.get("Ok")

    def camera(self):
        c = self.req({"Camera": None})
        return (c["Camera"]["x"], c["Camera"]["y"]) if c else (0.0, 0.0)

    def zoom(self):
        z = self.req({"Zoom": None})
        return z["Zoom"] if z else 1.0

    def set_camera(self, x, y):
        self.req({"Camera": [float(x), float(y)]})

    def set_zoom(self, z):
        self.req({"Zoom": float(z)})

    def state(self):
        st = self.req({"State": None})
        return st["State"] if st else {}

    def move(self, wid, x, y):
        # Both halves matter and both fail quietly. The window is selected
        # positionally — a named `id` field is ignored, and the move silently
        # lands on the focused window instead — and a Move with no destination
        # only reads the position back. Either mistake still answers Ok with
        # the coordinates you asked for, having moved nothing.
        self.req({"Move": [int(wid), [int(round(x)), int(round(y))]]})

    def focus(self, wid):
        self.req({"Focus": int(wid)})

    def opacity(self, wid, value):
        self.req({"Opacity": [int(wid), float(value)]})

    def action(self, name):
        self.req({"Action": name})


def screen(st):
    """Logical size of the active output."""
    outs = st.get("outputs") or []
    out = next((o for o in outs if o.get("active")), outs[0] if outs else {})
    w, h = out.get("size") or [1920, 1080]
    return float(w), float(h)


# ── Smooth flight ─────────────────────────────────────────────────────────
def fly(d, tx, ty, tz=WORK_ZOOM, rate=90):
    """Glide the view to a point. Never jumps.

    The camera is streamed as an eased path at `rate` Hz, paced against a
    deadline rather than by sleeping a fixed slice, so a flight takes the time
    it claims to even when the scheduler is busy.

    Zoom is sent exactly once, because driftwm anchors zoom on the pointer and
    re-derives the camera from it as it renders: a zoom command issued every
    frame drags the camera backwards and the flight never arrives. One command
    is also all that is needed — driftwm eases zoom itself over ~250ms.

    That single command is ordered like a real flight: zoom out before setting
    off, so you see the space you are about to cross, and zoom in on arrival.
    Afterwards the target is held briefly, because the tail of the zoom
    animation would otherwise pull the camera off the mark.
    """
    x0, y0 = d.camera()
    z0 = d.zoom()
    dist = math.hypot(tx - x0, ty - y0)
    zooming = abs(tz - z0) > 0.005

    # Duration scales gently with distance: short hops feel immediate, long
    # journeys read as travel.
    dur = 0.45 + 0.55 * min(1.0, dist / 6000.0)

    if zooming and tz < z0:
        d.set_zoom(tz)                                 # pull back, then travel

    steps = max(2, int(dur * rate))
    start = time.perf_counter()
    for i in range(1, steps + 1):
        t = i / steps
        e = 0.5 - 0.5 * math.cos(math.pi * t)          # ease in-out
        d.set_camera(x0 + (tx - x0) * e, y0 + (ty - y0) * e)
        ahead = (start + t * dur) - time.perf_counter()
        if ahead > 0:
            time.sleep(ahead)

    if zooming and tz > z0:
        d.set_zoom(tz)                                 # settle in on arrival

    hold = 0.4 if zooming else 0.06
    until = time.perf_counter() + hold
    while time.perf_counter() < until:
        d.set_camera(tx, ty)
        time.sleep(1.0 / rate)


# ── Places ────────────────────────────────────────────────────────────────
def find_place(token):
    """A planet by number, name prefix, or the role written on its name plate."""
    t = str(token).strip().lower()
    if t in ("sun", "0", "sol", "centre", "center"):
        return SUN
    for p in PLANETS:
        if t == str(p.n) or p.name.lower().startswith(t) or t == p.role:
            return p
    return None


def nearest(x, y):
    """Nearest place to a point, and how far away it is."""
    best, bd = SUN, math.hypot(x, y)
    for p in PLANETS:
        dd = math.hypot(x - p.x, y - p.y)
        if dd < bd:
            best, bd = p, dd
    return best, bd


# ── Districts ─────────────────────────────────────────────────────────────
# A window belongs where you put it, and otherwise to the place it is nearest.
#
# Nearest alone is not enough. A planet's neighbourhood here is narrower than
# a workspace — the orbits are 820 apart while a terminal is 700 wide — so a
# tidy grid of ten windows on Earth reaches past the halfway line to Mercury,
# and windows in the far corners would defect to a planet nobody sent them to.
# No orbit spacing fixes that: Mercury is genuinely close to the Sun. So
# `send` and `arrange` write down where a window was put, and that stands as
# long as the window stays in the neighbourhood. Drag it away and it belongs
# to whatever it is nearest again.
#
# Furniture — name plates, the map, the help card — is scenery, and never
# belongs to anyone.
CLAIMS = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "sol-districts.json")


def is_furniture(w):
    app = str(w.get("app_id", ""))
    return w.get("is_widget") or app.startswith(("sol-", "planet-label"))


def real_windows(st):
    return [w for w in st.get("windows", []) if not is_furniture(w)]


def read_claims():
    try:
        with open(CLAIMS) as f:
            return {int(k): int(v) for k, v in json.load(f).items()}
    except (OSError, ValueError):
        return {}


def write_claims(st, claims):
    """Save the record, forgetting windows that have since closed."""
    live = {w["id"] for w in real_windows(st)}
    try:
        with open(CLAIMS, "w") as f:
            json.dump({str(k): v for k, v in claims.items() if k in live}, f)
    except OSError:
        pass


def assignment(st):
    """{place number: [windows]} — who holds what, worked out once."""
    if "sol_districts" in st:
        return st["sol_districts"]
    claims = read_claims()
    held = {}
    for w in real_windows(st):
        x, y = w["position"]
        n = claims.get(w["id"], -1)
        put = PLACES[n] if 0 <= n < len(PLACES) else None
        if put and math.hypot(x - put.x, y - put.y) <= DISTRICT:
            place = put
        else:
            place, dd = nearest(x, y)
            if dd > DISTRICT:
                continue
        held.setdefault(place.n, []).append(w)
    for wins in held.values():
        wins.sort(key=lambda w: w["id"])
    st["sol_districts"] = held
    return held


def district(st, place):
    """The windows of one place, in a stable order."""
    return assignment(st).get(place.n, [])


def census(st):
    """{place number: window count} for everything that has any."""
    return {n: len(wins) for n, wins in assignment(st).items() if wins}


def plate_of(st, place):
    """A planet's name plate window, if it is running."""
    want = "planet-label-%d" % place.n
    return next((w for w in st.get("windows", []) if w.get("app_id") == want), None)


# ── Tidying ───────────────────────────────────────────────────────────────
def grid(place, wins, aspect):
    """Where each window should sit: rows of windows centred on the place.

    A grid rather than a ring of moons, for two reasons. It is the most
    compact arrangement, which matters because orbits here are 820 apart while
    a terminal is 700 wide — a planet's neighbourhood is barely wider than a
    single window, so anything that spreads bleeds into the next planet's. And
    its footprint can be shaped to the screen, so framing the district lands
    at a zoom where the windows are still usable rather than merely visible.

    Rows are filled to a target width and each keeps its own height, rather
    than every window getting a cell the size of the largest. One tall editor
    among nine terminals would otherwise inflate all ten cells and swell the
    district to no purpose. Every break point is tried; the one whose block
    best matches the shape of the screen wins.
    """
    if not wins:
        return [], 0.0, 0.0
    cells = [(w["size"][0] + GAP, w["size"][1] + GAP) for w in wins]
    notch = (2.0 * place.body + GAP, 2.0 * place.body + GAP)

    def fill(items, target):
        rows, row, wide = [], [], 0.0
        for i, (w, _) in enumerate(items):
            if row and wide + w > target:
                rows.append(row)
                row, wide = [], 0.0
            row.append(i)
            wide += w
        if row:
            rows.append(row)
        return rows

    def lay(items, rows, width):
        """Centre of every cell, relative to the middle of the block.

        Rows are justified: slack is shared into the gaps so the block has
        clean edges, but only up to one extra GAP, past which a short row is
        centred instead of being stretched into a gappy mess.
        """
        height = sum(max(items[i][1] for i in r) for r in rows)
        out = [None] * len(items)
        y = height / 2.0
        for r in rows:
            tall = max(items[i][1] for i in r)
            span = sum(items[i][0] for i in r)
            extra = min((width - span) / (len(r) - 1), GAP) if len(r) > 1 else 0.0
            x = -(span + extra * (len(r) - 1)) / 2.0
            for i in r:
                out[i] = (x + items[i][0] / 2.0, y - tall / 2.0)
                x += items[i][0] + extra
            y -= tall
        return out, height

    best = None
    for k in range(len(cells) + 1):                 # where the planet sits
        items = cells[:k] + [notch] + cells[k:]
        target = 0.0
        for w, _ in items:                          # every possible row break
            target += w
            rows = fill(items, target)
            width = max(sum(items[i][0] for i in r) for r in rows)
            centres, height = lay(items, rows, width)
            # Shape the block to the screen; keep the planet near the middle of
            # it, so the district reads as gathered around its world; and keep
            # the rows even, so no one window is left stranded on a line of
            # its own.
            adrift = math.hypot(*centres[k]) / (math.hypot(width, height) / 2.0)
            ragged = sum(width - sum(items[i][0] for i in r) for r in rows) \
                / (width * len(rows))
            score = abs(math.log((width / height) / aspect)) \
                + 1.2 * adrift + 2.2 * ragged
            if best is None or score < best[0]:
                best = (score, centres, k, width, height)

    _, centres, k, width, height = best
    # Anchor on the planet: its cell lands exactly on the planet itself.
    ox, oy = centres[k]
    slots = [(place.x + cx - ox, place.y + cy - oy)
             for i, (cx, cy) in enumerate(centres) if i != k]
    return slots, width, height


def tidy(d, st, place, aspect):
    """Lay a place's windows out in a grid and lift its name plate clear."""
    wins = district(st, place)
    slots, _, height = grid(place, wins, aspect)
    claims = read_claims()
    for w, (x, y) in zip(wins, slots):
        if [int(round(x)), int(round(y))] != list(w["position"]):
            d.move(w["id"], x, y)
        w["position"] = [int(round(x)), int(round(y))]
        claims[w["id"]] = place.n     # tidied here, so it belongs here
    write_claims(st, claims)

    plate = plate_of(st, place)
    if plate:
        top = place.y + (height / 2.0 if wins else 0.0)
        y = top + PLATE_GAP + plate["size"][1] / 2.0 if wins else place.y + 400
        if abs(y - plate["position"][1]) > 1 or plate["position"][0] != place.x:
            d.move(plate["id"], place.x, y)
        plate["position"] = [place.x, int(round(y))]
    return wins


def spotlight(d, st, focused=None):
    """Bring the focused window forward and set the rest a touch back."""
    for w in real_windows(st):
        lit = (w["id"] == focused) if focused is not None else w.get("is_focused")
        d.opacity(w["id"], 1.0 if lit else DIM)


# ── The card each district sits on ────────────────────────────────────────
# The shader cannot see the windows, so `sol` tells it: the rectangles are
# written between markers in sol.glsl and the config is reloaded, which is
# cheap and — unlike a restart — keeps the camera, the windows and their
# opacity exactly as they were. Everything outside the markers is left alone,
# and a shader without them simply gets no cards.
CARD_HEAD = "// ── districts ──"
CARD_TAIL = "// ── end districts ──"


def bounds(st, place):
    """The rectangle a district occupies: its windows and its world."""
    wins = district(st, place)
    if not wins:
        return None
    boxes = [(w["position"], w["size"]) for w in wins]
    boxes.append(((place.x, place.y), (place.body * 2, place.body * 2)))
    x0 = min(p[0] - s[0] / 2.0 for p, s in boxes) - CARD_PAD
    x1 = max(p[0] + s[0] / 2.0 for p, s in boxes) + CARD_PAD
    y0 = min(p[1] - s[1] / 2.0 for p, s in boxes) - CARD_PAD
    y1 = max(p[1] + s[1] / 2.0 for p, s in boxes) + CARD_PAD
    return (x0 + x1) / 2.0, (y0 + y1) / 2.0, (x1 - x0) / 2.0, (y1 - y0) / 2.0


def write_cards(d, st):
    try:
        with open(SHADER) as f:
            src = f.read()
    except OSError:
        return
    head, mark, rest = src.partition(CARD_HEAD)
    _, mark2, tail = rest.partition(CARD_TAIL)
    if not mark or not mark2:
        return

    lines = [CARD_HEAD]
    for i, p in enumerate(PLACES):
        box = bounds(st, p)
        if box:
            # Shader space is the canvas with y negated.
            lines.append("const vec4 D%d = vec4(%.1f, %.1f, %.1f, %.1f);"
                         % (i, box[0], -box[1], box[2], box[3]))
        else:
            lines.append("const vec4 D%d = vec4(0.0, 0.0, 0.0, 0.0);" % i)
    new = head + "\n".join(lines) + "\n" + CARD_TAIL + tail
    if new == src:
        return
    try:
        with open(SHADER, "w") as f:
            f.write(new)
    except OSError:
        return
    d.action("reload-config")


def frame(st, place, aspect_wh):
    """(x, y, zoom) that shows everything at a place — or just the place."""
    ow, oh = aspect_wh
    box = bounds(st, place)
    if not box:
        return float(place.x), float(place.y), WORK_ZOOM

    # The card is what you are looking at, so frame it whole, name plate and all.
    x0, x1 = box[0] - box[2], box[0] + box[2]
    y0, y1 = box[1] - box[3], box[1] + box[3]
    plate = plate_of(st, place)
    if plate:
        (px, py), (pw, ph) = plate["position"], plate["size"]
        x0, x1 = min(x0, px - pw / 2.0), max(x1, px + pw / 2.0)
        y0, y1 = min(y0, py - ph / 2.0), max(y1, py + ph / 2.0)

    z = min(ow / max(x1 - x0, 1.0), oh / max(y1 - y0, 1.0)) * 0.92
    return (x0 + x1) / 2.0, (y0 + y1) / 2.0, max(MIN_FRAME_ZOOM, min(WORK_ZOOM, z))


# ── Commands ──────────────────────────────────────────────────────────────
def cmd_goto(args):
    p = find_place(args[0]) if args else None
    if not p:
        sys.exit("sol goto: name a planet (1-8, Mercury..Neptune, a role, or sun)")
    d = Drift()
    st = d.state()
    fx, fy, fz = frame(st, p, screen(st))

    # A district too big to show at working zoom gets framed. Ask for the same
    # planet again from that overview and you dive in to get to work.
    if fz < WORK_ZOOM:
        cx, cy = d.camera()
        if math.hypot(cx - fx, cy - fy) < 200 and abs(d.zoom() - fz) < 0.05:
            wins = district(st, p)
            w = next((w for w in wins if w.get("is_focused")), wins[0] if wins else None)
            if w:
                d.focus(w["id"])
                spotlight(d, st, w["id"])
                fly(d, w["position"][0], w["position"][1], WORK_ZOOM)
                return
    fly(d, fx, fy, fz)


def cmd_hop(args):
    direction = (args[0] if args else "out").lower()
    d = Drift()
    x, y = d.camera()
    here, dist = nearest(x, y)
    idx = here.n
    if direction in ("in", "sunward", "left", "prev"):
        nxt = idx - 1
    else:
        nxt = idx + 1
    nxt = max(0, min(8, nxt))
    p = PLACES[nxt]
    st = d.state()
    fly(d, *frame(st, p, screen(st)))


def cmd_system(args):
    """Frame the whole solar system, centred on the Sun.

    driftwm clamps zoom-out to half the fit of the real windows on the canvas,
    which is why the planet name plates are ordinary windows: they hold the
    canvas open wide enough for this view to exist.
    """
    d = Drift()
    st = d.state()
    w, h = screen(st)
    z = min(w, h) / (2.3 * SYSTEM_R)
    fly(d, 0, 0, max(0.05, z))


def cmd_arrange(args):
    """Tidy a district into a grid — the answer to ten terminals in a heap."""
    d = Drift()
    st = d.state()
    ow, oh = screen(st)
    where = args[0] if args else None
    if where in ("all", "*"):
        places = PLACES
    else:
        p = find_place(where) if where else nearest(*d.camera())[0]
        if not p:
            sys.exit("sol arrange: unknown place")
        places = [p]
    for p in places:
        tidy(d, st, p, ow / oh)
    spotlight(d, st)
    write_plates(st)
    write_cards(d, st)
    if len(places) == 1:
        fly(d, *frame(st, places[0], (ow, oh)))


def cmd_step(args, step=1):
    """Focus the next window of the place we are at, and fly to it."""
    d = Drift()
    st = d.state()
    x, y = d.camera()
    here, dist = nearest(x, y)
    wins = district(st, here)
    if not wins:
        sys.exit("sol: no windows at %s" % here.name)
    cur = next((w for w in wins if w.get("is_focused")), None)
    if cur is None:
        # Focus is elsewhere: start from whatever is nearest the view.
        w = min(wins, key=lambda w: math.hypot(w["position"][0] - x, w["position"][1] - y))
    else:
        w = wins[(wins.index(cur) + step) % len(wins)]
    d.focus(w["id"])
    spotlight(d, st, w["id"])
    fly(d, w["position"][0], w["position"][1], WORK_ZOOM)


def cmd_send(args):
    if not args:
        sys.exit("sol send: name a planet")
    p = find_place(args[0])
    if not p:
        sys.exit("sol send: unknown planet")
    d = Drift()
    st = d.state()
    win = next((w for w in real_windows(st) if w.get("is_focused")), None)
    if not win:
        sys.exit("sol send: no focused window")
    was = next((q for q in PLACES if win in district(st, q)), None)
    ow, oh = screen(st)
    # Land it on the planet, then tidy — so sending ten windows to one planet
    # leaves a grid rather than ten windows on the same pixel.
    d.move(win["id"], p.x, p.y)
    win["position"] = [p.x, p.y]
    claims = read_claims()
    claims[win["id"]] = p.n
    write_claims(st, claims)
    st.pop("sol_districts", None)          # it has a new home; work it out again
    tidy(d, st, p, ow / oh)
    if was and was.n != p.n:
        tidy(d, st, was, ow / oh)          # and the district it left behind
    spotlight(d, st)
    write_plates(st)
    write_cards(d, st)
    if "--stay" not in args:
        fly(d, *frame(st, p, (ow, oh)))


def whereabouts(st, cam, zoom):
    """(place, on_it, how many windows it has) for the current view.

    Arrival is judged in screen terms, not canvas terms: pulled back far
    enough that a planet fills the view, you are at that planet even though
    the numbers say you are thousands of pixels away.
    """
    ow, oh = screen(st)
    x, y = cam
    counts = census(st)
    if math.hypot(x, y) < SYSTEM_R and ow / max(zoom, 0.01) > 1.7 * SYSTEM_R:
        return None, False, sum(counts.values())          # the whole system
    # Standing anywhere on a district's own card is being at that place, however
    # far the planet itself is — a window at the far corner of Earth's workspace
    # is still on Earth, not adrift.
    for p in PLACES:
        box = bounds(st, p)
        if box and abs(x - box[0]) <= box[2] and abs(y - box[1]) <= box[3]:
            return p, True, counts.get(p.n, 0)
    place, dist = nearest(x, y)
    reach = max(ARRIVE_RADIUS, min(oh, ow) / (2.0 * max(zoom, 0.01)) * 0.55)
    return place, dist <= reach, counts.get(place.n, 0)


def windows_word(n):
    return "%d window%s" % (n, "" if n == 1 else "s")


# The name plates show a live tally, but they must not cost anything to keep
# live: eight terminals each waking a Python process every few seconds would
# burn more CPU than the whole canvas. So the plates read one small file, and
# `sol here` — which waybar already runs once a second, and which has the
# census in hand anyway — is what writes it.
PLATES = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "sol-plates")


def plate_line(p, n):
    """The line a planet's name plate shows: "3  E A R T H  home · 10"."""
    tail = "%s · %d" % (p.role, n) if n else p.role
    return "  %d   %s   \033[2m%s\033[0m" % (p.n, " ".join(p.name.upper()), tail)


def write_plates(st):
    counts = census(st)
    text = "".join(plate_line(p, counts.get(p.n, 0)) + "\n" for p in PLANETS)
    try:
        with open(PLATES) as f:
            if f.read() == text:
                return
    except OSError:
        pass
    try:
        with open(PLATES, "w") as f:
            f.write(text)
    except OSError:
        pass


def cmd_plate(args):
    """Print one plate's line — what the plates read from the file."""
    p = find_place(args[0]) if args else None
    if not p:
        sys.exit("sol plate: name a planet")
    print(plate_line(p, census(Drift().state()).get(p.n, 0)))


# ── The bar ───────────────────────────────────────────────────────────────
# The bar borrows the shape of the macOS menu bar, because the mapping is
# exact: the planet you are on is the frontmost application. So ☉ opens the
# menu where  would be, the place is named in bold where the app name goes,
# what it holds reads as that app's menus, and the status glyphs and the
# clock sit on the right in that order.
#
# Three of those modules want the same census, and none of them should pay
# for it. `sol here` is the one that asks — it already runs once a second for
# the plates — and it leaves the finished JSON in one file for the others to
# read. `sol bar strip` is then a seek and a print: no IPC, no state, no cost.
BAR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "sol-bar")
BAR_PARTS = ("where", "holding", "strip")

RING = "①②③④⑤⑥⑦⑧"          # a planet, as the key that flies you to it
SUP = "⁰¹²³⁴⁵⁶⁷⁸⁹"          # its tally, small enough to read as a badge
DIMC = "#3b4261"            # an empty planet: present, but not asking for you


def strip_markup(counts, here):
    """The eight planets as one line: where you are, and who is holding what.

    Ordinal rather than spatial, because that is how the system is actually
    used — nobody flies by angle, they fly by number. All eight keep the same
    ring so every digit stays readable; the one you are standing on is
    underlined, the way a Mac marks the selected segment of anything. The
    belt keeps its place in the middle, as the divide it is.
    """
    out = []
    for p in PLANETS:
        n = counts.get(p.n, 0)
        badge = "".join(SUP[int(c)] for c in str(n)) if n else ""
        colour = p.colour if (n or p is here) else DIMC
        mark = ' underline="single" underline_color="%s"' % p.colour if p is here else ""
        out.append('<span foreground="%s"%s>%s%s</span>'
                   % (colour, mark, RING[p.n - 1], badge))
        if p.n == 4:
            out.append('<span foreground="#2a2f45">┊</span>')
    return "  ".join(out)


def write_bar(st, place, on_it, n, z):
    counts = census(st)
    here = place if (place and on_it and place is not SUN) else None
    if place is None:
        name, cls, role = "the system", "system", "all eight planets"
    elif not on_it:
        name, cls, role = "deep space", "space", "between worlds"
    else:
        name, cls, role = place.name, place.name.lower(), place.role

    holding = role if not n else "%s · %d" % (role, n)
    tally = "  ".join("%d %s · %d" % (p.n, p.name, counts[p.n])
                      for p in PLANETS if counts.get(p.n)) or "nothing on the canvas"
    text = "\n".join(json.dumps(o) for o in (
        {"text": name, "class": cls, "tooltip": "%s — %d%%" % (role, int(z * 100))},
        {"text": holding, "class": cls, "tooltip": windows_word(n) if n else role},
        {"text": strip_markup(counts, here), "class": "strip", "tooltip": tally},
    )) + "\n"
    try:
        with open(BAR) as f:
            if f.read() == text:
                return text
    except OSError:
        pass
    try:
        with open(BAR, "w") as f:
            f.write(text)
    except OSError:
        pass
    return text


def cmd_bar(args):
    """One line of the bar, straight from the file `sol here` leaves."""
    part = args[0] if args else "where"
    if part not in BAR_PARTS:
        sys.exit("sol bar: %s (want one of: %s)" % (part, ", ".join(BAR_PARTS)))
    try:
        with open(BAR) as f:
            print(f.read().split("\n")[BAR_PARTS.index(part)])
    except (OSError, IndexError):
        print(json.dumps({"text": "", "class": "space"}))


def cmd_here(args):
    d = Drift()
    st = d.state()
    z = d.zoom()
    place, on_it, n = whereabouts(st, d.camera(), z)
    write_plates(st)          # the heartbeat that keeps the name plates current
    bar = write_bar(st, place, on_it, n, z)

    if place is None:
        role, label = "all eight planets", "the system"
    elif not on_it:
        role, label = "between worlds", "deep space"
    else:
        role = place.role
        label = place.name if place is SUN else "%d %s" % (place.n, place.name)

    if "--waybar" in args:
        print(bar.split("\n")[0])
    else:
        print("%s  (%s)%s" % (label, role, "  ·  " + windows_word(n) if n else ""))


def cmd_list(args):
    d = Drift()
    st = d.state()
    counts = census(st)
    total = len(real_windows(st))
    for p in PLACES:
        wins = district(st, p)
        if not wins:
            continue
        head = p.name if p is SUN else "%d %s" % (p.n, p.name)
        print("%-12s %-9s %d" % (head, p.role, len(wins)))
        for w in wins:
            print("    %-18s %s" % (str(w.get("app_id"))[:18], w.get("title", "")[:44]))
    stray = total - sum(counts.values())
    if stray:
        print("%-12s %-9s %d" % ("deep space", "adrift", stray))
    if not total:
        print("no windows on the canvas")


def cmd_menu(args):
    """The ☉ menu — everywhere you can go, and the few things you can do.

    This is what the ☉ at the left of the bar opens, so it carries the same
    weight as the  menu it sits where: the places first, with what each is
    holding, then the handful of actions that are about the canvas itself.
    """
    d = Drift()
    st = d.state()
    counts = census(st)
    items = ["☉  Sun — home base"]
    for p in PLANETS:
        n = counts.get(p.n, 0)
        items.append("%d  %s — %s%s" % (p.n, p.name, p.role,
                                        "  ·  %d" % n if n else ""))
    items += ["─  Overview", "─  Whole system", "─  Tidy this planet",
              "─  Keybindings"]
    import subprocess
    cmd = ["fuzzel", "--dmenu", "--lines", str(len(items))]
    if os.path.exists(FUZZEL):        # ours if it is there, yours if it is not
        cmd += ["--config", FUZZEL]
    try:
        out = subprocess.run(cmd, input="\n".join(items), text=True,
                             capture_output=True).stdout.strip()
    except FileNotFoundError:
        sys.exit("sol menu: fuzzel not installed")
    if not out:
        return
    tail = out.split(None, 1)[-1].strip()
    if out.startswith("☉"):
        cmd_goto(["sun"])
    elif not out.startswith("─"):
        cmd_goto([out.split()[0]])
    elif tail == "Overview":
        subprocess.Popen(["sol-map"], start_new_session=True)
    elif tail == "Whole system":
        cmd_system([])
    elif tail == "Tidy this planet":
        cmd_arrange([])
    elif tail == "Keybindings":
        subprocess.Popen(["sol-help"], start_new_session=True)


HELP = """
   ☉  S O L  —  the canvas is our solar system

   Sun at the centre, planets in the order you already know.
   Distance from the Sun is distance from your attention:
   inner = immediate, the asteroid belt divides, outer = background.

   GO                                  DO
   mod+1 … mod+8   fly to a planet     mod+return   terminal
   mod+0           fly to the Sun      mod+space    launcher
   mod+left/right  sunward / outward   mod+q        close window
   mod+u           whole system view   mod+f        fullscreen
   mod+tab         fly-to menu         mod+m        maximise
   mod+e           the overview        mod+/        this card

   CARRY                               A CROWDED PLANET
   mod+ctrl+1 … 8  send window         mod+a        tidy into a grid
                   to that planet      mod+n/mod+p  step through them
                                       mod+N again  overview, then dive in

   A planet with more windows than fit the screen is framed whole when
   you fly to it; press the same key again to drop into your window.

   mod+e opens the overview: the whole system at a size that resolves,
   every window named, 1…8 to fly and ⏎ to drop into the one you picked.
   The strip in the bar counts what each planet is holding meanwhile.

   1 Mercury quick   3 Earth home    5 Jupiter builds  7 Uranus spare
   2 Venus   comms   4 Mars   ops    6 Saturn  media   8 Neptune archive
"""


def cmd_help(args):
    print(HELP)
    if "--hold" in args:
        try:
            while True:
                time.sleep(3600)
        except KeyboardInterrupt:
            pass


# ── The overview ──────────────────────────────────────────────────────────
# What this replaces was a 40x20 square parked in the corner of every screen.
# At that size the whole system comes to 401 canvas units a cell: neighbouring
# orbits land two cells apart, a district is two rows tall, and there is
# nowhere to say what any window actually is — so it drew the shape of a
# system you already knew by heart and none of what you would open a map for.
#
# It is full screen now, and asked for rather than parked. That buys the
# resolution to draw a district as a rectangle instead of a smear, room to
# name every window in it, and the corner of your screen back.
C_DIM, C_FG, C_CAM = "\033[38;2;65;72;104m", "\033[38;2;192;202;245m", "\033[38;2;125;207;255m"
C_SUN, C_RST = "\033[38;2;224;175;104m", "\033[0m"
C_ORB = "\033[38;2;48;56;84m"       # the orbit hairlines, kept to a whisper
C_KEY = "\033[38;2;86;95;137m"      # the key hints along the bottom
PCOL = {1: "\033[38;2;154;165;206m", 2: "\033[38;2;224;175;104m",
        3: "\033[38;2;122;162;247m", 4: "\033[38;2;247;118;142m",
        5: "\033[38;2;255;158;100m", 6: "\033[38;2;230;207;161m",
        7: "\033[38;2;125;207;255m", 8: "\033[38;2;90;127;208m"}
PCOL[0] = C_SUN

OV_SPAN = SYSTEM_R * 1.10
PANE = 34                           # side pane: what the selected planet holds
TOP = 3                             # the map starts on this terminal row
LEFT = 2                            # ... and in this column


def orbit_points(p, n=200):
    """Points along a planet's real ellipse, with the Sun at a focus."""
    w = math.radians(p.peri)
    cw, sw = math.cos(w), math.sin(w)
    b = p.a * math.sqrt(1 - p.e * p.e)
    cx, cy = -p.a * p.e * cw, -p.a * p.e * sw
    for k in range(n):
        t = 2 * math.pi * k / n
        u, v = p.a * math.cos(t), b * math.sin(t)
        yield cx + u * cw - v * sw, cy + u * sw + v * cw


DOTS = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))


class Sheet:
    """A character grid with a braille layer underneath it.

    Terminal cells are about twice as tall as they are wide, so an orbit
    plotted a whole cell at a time comes out as a flat ellipse in visible
    stair-steps. The dim layer — the orbits and the belt, which are all one
    colour anyway — is plotted into braille instead: eight dots to the cell,
    two across and four down, which lands them on a square sub-pixel and
    draws the ellipses as fine dotted lines rather than a staircase of
    blocks. Everything that carries a colour of its own is drawn over the
    top, a whole cell at a time.
    """

    def __init__(self, w, h, span):
        self.w, self.h, self.span = w, h, span
        self.cell = [[None] * w for _ in range(h)]
        self.sub = [[0] * w for _ in range(h)]

    def col(self, x):
        return int((x + self.span) / (2 * self.span) * self.w)

    def row(self, y):
        return int((self.span - y) / (2 * self.span) * self.h)

    def world(self, c, r):
        x = (c + 0.5) / self.w * 2 * self.span - self.span
        y = self.span - (r + 0.5) / self.h * 2 * self.span
        return x, y

    def dot(self, x, y):
        sx = int((x + self.span) / (2 * self.span) * self.w * 2)
        sy = int((self.span - y) / (2 * self.span) * self.h * 4)
        c, r = sx // 2, sy // 4
        if 0 <= r < self.h and 0 <= c < self.w:
            self.sub[r][c] |= DOTS[sy % 4][sx % 2]

    def free(self, r, c, n):
        """Is there room for n characters at this row and column?"""
        if not (0 <= r < self.h and 0 <= c and c + n <= self.w):
            return False
        return all(self.cell[r][c + i] is None for i in range(n))

    def put(self, x, y, ch, colour):
        c, r = self.col(x), self.row(y)
        if 0 <= r < self.h and 0 <= c < self.w:
            self.cell[r][c] = (ch, colour)
        return r, c

    def text(self, r, c, s, colour):
        for i, ch in enumerate(s):
            if 0 <= r < self.h and 0 <= c + i < self.w:
                self.cell[r][c + i] = (ch, colour)

    def label(self, r, c, s, colour):
        """A planet's name, in the first place beside it that is free.

        Every planet gets named or the overview has not done its job, so this
        works outwards — right of the marker, then left, then the rows below
        and above — and if the whole neighbourhood is taken it writes anyway.
        A name over a district's border edge still reads; a planet with no
        name at all is the one outcome worth avoiding.
        """
        spots = []
        for dr in (0, 1, -1, 2, -2):
            spots += [(r + dr, c + 2), (r + dr, c - len(s) - 1)]
        for rr, cc in spots:
            if self.free(rr, cc, len(s)):
                self.text(rr, cc, s, colour)
                return
        self.text(r, c + 2 if c < self.w // 2 else c - len(s) - 1, s, colour)

    def box(self, x, y, hw, hh, colour):
        """A district's card, as a rounded rectangle."""
        c0, c1 = self.col(x - hw), self.col(x + hw)
        r0, r1 = self.row(y + hh), self.row(y - hh)
        if c1 - c0 < 2 or r1 - r0 < 1:
            return
        for c in range(c0 + 1, c1):
            for r in (r0, r1):
                if 0 <= r < self.h and 0 <= c < self.w:
                    self.cell[r][c] = ("─", colour)
        for r in range(r0 + 1, r1):
            for c in (c0, c1):
                if 0 <= r < self.h and 0 <= c < self.w:
                    self.cell[r][c] = ("│", colour)
        for r, c, ch in ((r0, c0, "╭"), (r0, c1, "╮"), (r1, c0, "╰"), (r1, c1, "╯")):
            if 0 <= r < self.h and 0 <= c < self.w:
                self.cell[r][c] = (ch, colour)

    def lines(self):
        out = []
        for r in range(self.h):
            row = []
            for c in range(self.w):
                got = self.cell[r][c]
                if got:
                    row.append(got[1] + got[0] + C_RST)
                elif self.sub[r][c]:
                    row.append(C_ORB + chr(0x2800 + self.sub[r][c]) + C_RST)
                else:
                    row.append(" ")
            out.append("".join(row))
        return out


def win_name(w):
    """A window, as (what it is, what it is showing).

    The app id is what you sent here and what the rules address; the title is
    whatever it happens to be doing. Both, when they differ — a switcher that
    lists ten identical app ids has told you nothing.
    """
    app = str(w.get("app_id") or "").strip()
    title = (w.get("title") or "").strip()
    if not app:
        return title or "window", ""
    return app, "" if title.lower() in ("", app.lower()) else title


def cell_aspect():
    """How much taller than wide a terminal cell is, asked rather than assumed.

    A cell is roughly 2:1, and "roughly" is what turns a circle into an egg.
    foot reports the window's pixel size alongside its cell counts, so the
    true ratio is there for the asking and the orbits come out round under
    any font. Anything that will not say falls back to the usual 2.2.
    """
    try:
        import fcntl
        import struct
        import termios
        rows, cols, xp, yp = struct.unpack(
            "HHHH", fcntl.ioctl(sys.stdout, termios.TIOCGWINSZ, b"\0" * 8))
        if rows and cols and xp and yp:
            return max(1.2, min(3.5, (yp / rows) / (xp / cols)))
    except Exception:
        pass
    return 2.2


def draw_overview(d, sel, size):
    """Paint the whole system, and what the selected planet is holding."""
    st = d.state()
    cols, rows = size
    cx, cy = st.get("camera", [0, 0])
    z = st.get("zoom", 1.0) or 1.0
    ow, oh = screen(st)
    counts = census(st)

    mh = max(8, rows - TOP - 3)
    mw = max(20, min(cols - PANE - LEFT - 3, int(mh * cell_aspect())))
    sh = Sheet(mw, mh, OV_SPAN)

    for p in PLANETS:                                   # orbits, then the belt
        for x, y in orbit_points(p, 8 * mw):
            sh.dot(x, y)
    for k in range(2 * mw):
        a = 2 * math.pi * k / (2 * mw)
        sh.dot(BELT_R * math.cos(a), BELT_R * math.sin(a))

    # The viewport, so the overview always says where you are looking.
    hw, hh = ow / (2 * z), oh / (2 * z)
    sh.box(cx, cy, min(hw, sh.span), min(hh, sh.span), C_CAM)

    here, on_it, _ = whereabouts(st, (cx, cy), z)
    marks = []
    for p in PLACES:
        wins = district(st, p)
        if wins:                                        # the card, then its windows
            b = bounds(st, p)
            if b:
                sh.box(b[0], b[1], b[2], b[3], C_DIM)
            for w in wins:
                sh.put(w["position"][0], w["position"][1], "▪", PCOL[p.n])
        lit = PCOL[p.n] + ("\033[1m" if counts.get(p.n) else "")
        r, c = sh.put(p.x, p.y, "☉" if p is SUN else str(p.n), lit)
        marks.append((p, r, c, lit))

    # The names go on last, so each can see where the others landed. The Sun
    # keeps only its glyph: it is the one body nobody has to be told.
    for p, r, c, lit in marks:
        if p is SUN:
            continue
        tag = "%s·%d" % (p.name, counts[p.n]) if counts.get(p.n) else p.name
        sh.label(r, c, ("▸" + tag) if p is sel[0] else tag, lit)

    body = sh.lines()

    # ── the side pane: what the selected planet is holding ──
    p = sel[0]
    wins = district(st, p)
    head = p.name if p is SUN else "%d %s" % (p.n, p.name)
    pane = [PCOL[p.n] + "\033[1m" + head.upper() + C_RST,
            C_DIM + "%s · %s" % (p.role, windows_word(len(wins)) if wins
                                 else "empty") + C_RST, ""]
    for i, w in enumerate(wins[:mh - 4]):
        app, title = win_name(w)
        app = app[:14]
        row = "%-15s%s" % (app, title[:PANE - 18])
        if i == sel[1]:
            pane.append(PCOL[p.n] + "▸ " + row + C_RST)
        else:
            pane.append(C_FG + "  " + app.ljust(15) + C_RST
                        + C_DIM + title[:PANE - 18] + C_RST)
    if len(wins) > mh - 4:
        pane.append(C_DIM + "  … and %d more" % (len(wins) - (mh - 4)) + C_RST)

    where = ("the system" if here is None else "deep space" if not on_it
             else here.name if here is SUN else "%d %s" % (here.n, here.name))
    head = " ☉  S O L" + "   " + C_DIM + where + " · " + \
        windows_word(len(real_windows(st))) + " · %d%%" % int(z * 100) + C_RST
    keys = ("1…8 fly  ·  ↑↓ pick  ·  ⏎ dive in  ·  a tidy  ·  "
            "u system  ·  click anywhere  ·  esc")

    buf = ["\033[H", C_FG + head + C_RST + "\033[K\n\033[K\n"]
    for i in range(mh):
        buf.append(" " * LEFT + body[i])
        if i < len(pane):
            buf.append("  " + pane[i])
        buf.append("\033[K\n")
    buf.append("\033[K\n" + " " * LEFT + C_KEY + keys + C_RST + "\033[K")
    sys.stdout.write("".join(buf))
    sys.stdout.flush()
    return sh, st


def next_key(buf):
    """Pull one keystroke off the front of the buffer.

    Returns (key, rest), or (None, buf) when the buffer holds the start of an
    escape sequence whose tail has not arrived yet. Keys have to be parsed out
    of a buffer rather than read one byte at a time because an arrow key is
    three bytes that arrive together: read them through a buffered stream and
    select() — which watches the file descriptor, not Python's buffer — will
    say there is nothing more to come, and the tail of the sequence is thrown
    away. So the reading is raw, and the framing happens here.
    """
    if not buf.startswith("\033"):
        return buf[0], buf[1:]
    if len(buf) == 1:
        return None, buf                       # ESC alone, or the start of more
    if buf[1] != "[":
        return buf[:2], buf[2:]
    if buf.startswith("\033[<"):               # an SGR mouse report
        for i in range(3, len(buf)):
            if buf[i] in "Mm":
                return buf[:i + 1], buf[i + 1:]
        return (None, buf) if len(buf) < 32 else ("", "")
    for i in range(2, len(buf)):               # any other CSI: ends on a final
        if "@" <= buf[i] <= "~":
            return buf[:i + 1], buf[i + 1:]
    return None, buf


def cmd_map(args):
    """The overview — the whole system, named, on demand.

    Opened and closed with mod+e (or the ▦ in the bar). Because it is a
    window like any other, closing it costs nothing to remember: the process
    ends and the screen is yours again.
    """
    d = Drift()
    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    try:
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)
    except Exception:
        old = None
    sys.stdout.write("\033[?1049h\033[?25l\033[2J\033[?1006h\033[?1000h")

    st0 = d.state()
    at, _, _ = whereabouts(st0, d.camera(), d.zoom())
    sel = [at if at else SUN, 0]
    sh, st = None, st0
    buf, last = "", 0.0
    try:
        while True:
            if time.time() - last > 0.5:
                try:
                    size = os.get_terminal_size()
                    size = (size.columns, size.lines)
                except OSError:
                    size = (120, 40)
                sh, st = draw_overview(d, sel, size)
                last = time.time()

            r, _, _ = select.select([sys.stdin], [], [], 0.12)
            if not r:
                if buf == "\033":              # Esc, with nothing following it
                    return
                buf = ""
                continue
            try:
                chunk = os.read(fd, 64).decode("utf-8", "ignore")
            except OSError:
                return
            if not chunk:                      # stdin closed under us
                return
            buf += chunk

            while buf:
                key, rest = next_key(buf)
                if key is None:                # a sequence still arriving
                    break
                buf = rest
                if key.startswith("\033[<"):
                    if not click(d, st, sh, sel, key):
                        return
                    last = 0
                    continue
                if not step_key(d, st, sel, key):
                    return
                last = 0
    except KeyboardInterrupt:
        pass
    finally:
        if old:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?1000l\033[?1006l\033[?25h\033[?1049l")


def step_key(d, st, sel, key):
    """Act on one keystroke. False means the overview is done."""
    wins = district(st, sel[0])
    if key in ("q", "\033"):
        return False
    if key in ("\033[A", "k"):
        sel[1] = max(0, sel[1] - 1)
    elif key in ("\033[B", "j"):
        sel[1] = min(max(0, len(wins) - 1), sel[1] + 1)
    elif key in ("\033[D", "h", "\033[C", "l"):
        step = -1 if key in ("\033[D", "h") else 1
        sel[0] = PLACES[(PLACES.index(sel[0]) + step) % len(PLACES)]
        sel[1] = 0
    elif len(key) == 1 and key in "012345678":
        sel[0], sel[1] = PLACES[int(key)], 0
        fly(d, *frame(st, sel[0], screen(st)))
    elif key == "u":
        cmd_system([])
        sel[0] = SUN
    elif key == "a":
        cmd_arrange([str(sel[0].n)])
    elif key in ("\r", "\n"):
        if wins:
            dive(d, st, wins[min(sel[1], len(wins) - 1)])
            return False
    return True


def click(d, st, sh, sel, seq):
    """Act on one mouse report. False means the overview is done.

    Clicking the map flies you there — and clicking the cell a planet is
    drawn in means that planet, so the click lands on something meaningful
    rather than a point in empty space near it. Clicking a row of the side
    pane goes all the way: that window, focused, with the view on it.
    """
    try:
        btn, col, row = (int(v) for v in seq[3:-1].split(";"))
    except ValueError:
        return True
    if not seq.endswith("M") or btn != 0 or sh is None:
        return True
    c, r = col - 1 - LEFT, row - TOP
    if 0 <= r < sh.h and 0 <= c < sh.w:
        hit = next((q for q in PLACES if (sh.row(q.y), sh.col(q.x)) == (r, c)), None)
        if hit:
            sel[0], sel[1] = hit, 0
            fly(d, *frame(st, hit, screen(st)))
        else:
            fly(d, *sh.world(c, r), z_or(d, 0.5))
    elif c >= sh.w:
        i = r - 3                              # the pane's list starts here
        wins = district(st, sel[0])
        if 0 <= i < len(wins):
            sel[1] = i
            dive(d, st, wins[i])
            return False
    return True


def z_or(d, floor):
    """Keep the zoom you had when clicking empty space, unless you are far out."""
    z = d.zoom()
    return z if z >= floor else 1.0


def dive(d, st, w):
    """Focus a window, bring it forward, and fly to it."""
    d.focus(w["id"])
    spotlight(d, st, w["id"])
    fly(d, w["position"][0], w["position"][1], WORK_ZOOM)


# ── Entry ─────────────────────────────────────────────────────────────────
CMDS = {"goto": cmd_goto, "hop": cmd_hop, "system": cmd_system, "send": cmd_send,
        "here": cmd_here, "menu": cmd_menu, "map": cmd_map, "help": cmd_help,
        "arrange": cmd_arrange, "list": cmd_list, "plate": cmd_plate, "bar": cmd_bar,
        "next": lambda a: cmd_step(a, 1), "prev": lambda a: cmd_step(a, -1)}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(HELP)
        print("  commands: " + "  ".join(sorted(CMDS)))
        return
    cmd = sys.argv[1]
    if cmd == "fly":
        d = Drift()
        a = sys.argv[2:]
        fly(d, float(a[0]), float(a[1]), float(a[2]) if len(a) > 2 else WORK_ZOOM)
        return
    fn = CMDS.get(cmd)
    if not fn:
        sys.exit("sol: unknown command '%s' (try: %s)" % (cmd, ", ".join(sorted(CMDS))))
    fn(sys.argv[2:])


if __name__ == "__main__":
    main()
