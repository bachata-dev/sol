#!/usr/bin/env python3
"""sol — navigate the driftwm canvas as our solar system.

The canvas is a heliocentric map: the Sun sits at the origin and the eight
planets sit where they really are on the date the layout was generated, each
on its own ellipse, ordered outward exactly as everyone learned them. Distance
from the Sun is distance from your attention: inner planets are immediate,
the asteroid belt divides, outer planets are background.

Every window belongs to a place — where you sent it, or failing that whatever
it is nearest. That district is what lets `sol` answer "what is on Earth?":
it can frame the district, tidy it into a grid, count it on the map, and step
through it one window at a time.

Everything here talks to driftwm over its JSON IPC socket. All camera motion
goes through fly(), which interpolates position and zoom at 90 Hz with an
ease-in-out curve — so the view always travels, and never jumps.

  sol goto <name|number|sun>   fly to a planet; again to dive into its windows
  sol hop <in|out>             fly to the next planet sunward / outward
  sol dive                     go to the place the view is already at
  sol system                   frame the whole solar system
  sol arrange [where|all]      tidy a planet's windows into a grid
  sol next / sol prev          step through the windows of this planet
  sol send <name|number>       send the focused window to a planet
  sol gather [place]           bring every adrift window in (default: the Sun)
  sol sweep [from] [to]        drain a planet's stack to the archive
  sol tour                     a narrated first flight; touch anything to stop
  sol doctor                   is this machine set up right? paste me in bug reports
  sol list                     what is where
  sol here [--waybar]          where am I?
  sol menu [system|go]         the context menu · the ☉ menu · the switcher
  sol map                      the overview (runs inside a terminal)
  sol bar <where|holding|strip>  one line of the bar
  sol help [--hold]            keybinding card
"""

import json
import math
import os
import signal
import socket
import sys
import time
from collections import namedtuple

# Everything else is imported inside the function that needs it, and that is
# deliberate. `sol here` and `sol bar` are run once a second each by waybar, so
# every module this file imports at the top is paid for twice a second forever.
# The ones held back are the expensive ones and are wanted by nothing on that
# path: readline costs 33ms, subprocess and ctypes about 8ms apiece — some 50ms
# of startup, twice a second, to support `sol prompt` and `sol doctor`. Please
# do not tidy them upward.

# ── The solar system ──────────────────────────────────────────────────────
# Canvas coordinates (Y-up), from the real sky for 2029-01-01: each planet is
# placed by solving Kepler's equation, so it sits on its own ellipse at the
# angle it really occupied. Orbits keep their real eccentricity and perihelion
# direction — the Sun is at a focus, not the centre — while the semi-major
# axes are spaced uniformly, so every hop is a comparable distance.
# Regenerate for another date with tools/sol-positions.py.
Planet = namedtuple("Planet", "n name x y a e peri body colour role")
#             n  name        x      y     a   ecc     perihelion° body  colour   role
PLANETS = [
    Planet(1, "Mercury",    789,    331, 1000, 0.20564,   77.50,  76, "#9aa5ce", "quick"),
    Planet(2, "Venus",  -1089,  -1461, 1820, 0.00676,  131.60, 103, "#e0af68", "comms"),
    Planet(3, "Earth",   -471,   2553, 2640, 0.01670,  103.03, 105, "#7aa2f7", "home"),
    Planet(4, "Mars",  -3202,   2007, 3460, 0.09342,  -23.81,  85, "#f7768e", "ops"),
    Planet(5, "Jupiter",  -4344,  -1125, 4280, 0.04835,   14.79, 233, "#ff9e64", "builds"),
    Planet(6, "Saturn",   3789,   3146, 5100, 0.05371,   92.48, 220, "#e6cfa1", "media"),
    Planet(7, "Uranus",   1826,   5663, 5920, 0.04724,  171.07, 166, "#7dcfff", "spare"),
    Planet(8, "Neptune",   6634,    890, 6740, 0.00861,   44.87, 165, "#5a7fd0", "archive"),
]
SUN = Planet(0, "Sun", 0, 0, 0, 0.0, 0.0, 502, "#f0d99a", "home base")
PLACES = [SUN] + PLANETS
BELT_R = 3870          # asteroid belt radius, between Mars and Jupiter
SYSTEM_R = 6800        # outermost orbit, at aphelion

WORK_ZOOM = 1.0
ARRIVE_RADIUS = 900    # how close counts as "on" a planet
DISTRICT = 2600        # how far a window can sit and still belong to a planet
MIN_FRAME_ZOOM = 0.16  # never pull back further than this to frame a district
GAP = 90               # breathing room between tidied windows
PLATE_GAP = 40         # and between the top of a district and its name plate
DIM = 0.90             # unfocused windows, so the focused one stands forward
CARD_PAD = 70          # margin of the card a district sits on
SHADER = os.path.expanduser("~/.config/driftwm/sol.glsl")
FUZZEL = os.path.expanduser("~/.config/driftwm/fuzzel.ini")
FOOT_INI = os.path.expanduser("~/.config/driftwm/foot.ini")


def runtime(name):
    """Where sol keeps something for the length of one session.

    Claims, order, plates, the bar, the footer, the moving stamp: all of them
    describe a running canvas and none of them should outlive the boot that
    made them, which is exactly what XDG_RUNTIME_DIR is for. /tmp is the
    fallback for a session that has none — a bare tty, a stripped container —
    where the files are merely less private rather than missing.
    """
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", name)


# ── IPC ───────────────────────────────────────────────────────────────────
def sockets():
    """Every driftwm IPC socket on the machine, in a stable order.

    Spelled out rather than handed to glob(), which costs six milliseconds of
    import — it pulls in re, fnmatch and contextlib — on a command a
    keybinding runs on every press. The pattern is two literal directory
    levels and one prefix, which is less code written out than the import
    costs to read it.
    """
    found = []
    for user in os.listdir("/run/user"):
        where = "/run/user/%s/driftwm" % user
        try:
            found += [os.path.join(where, name) for name in os.listdir(where)
                      if name.startswith("ipc-") and name.endswith(".sock")]
        except OSError:
            continue                    # somebody else's, or gone since
    return sorted(found)


class Drift:
    def __init__(self):
        try:
            socks = sockets()
        except OSError:
            socks = []
        env = os.environ.get("DRIFTWM_SOCKET")
        path = env if env else (socks[0] if socks else None)
        if not path:
            sys.exit("sol: driftwm is not running (no IPC socket found)")
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s.settimeout(3)
        self.s.connect(path)
        self.f = self.s.makefile("rwb")

    def req(self, obj):
        self.f.write((json.dumps(obj) + "\n").encode())
        self.f.flush()
        line = self.f.readline().decode().strip()
        if not line:
            return None
        r = json.loads(line)
        return r.get("Ok")

    def camera(self):
        c = self.req({"Camera": None})
        return (c["Camera"]["x"], c["Camera"]["y"]) if c else (0.0, 0.0)

    def zoom(self):
        z = self.req({"Zoom": None})
        return z["Zoom"] if z else 1.0

    def set_camera(self, x, y):
        self.req({"Camera": [float(x), float(y)]})

    def set_zoom(self, z):
        self.req({"Zoom": float(z)})

    def state(self):
        st = self.req({"State": None})
        return st["State"] if st else {}

    def move(self, wid, x, y):
        # Both halves matter and both fail quietly. The window is selected
        # positionally — a named `id` field is ignored, and the move silently
        # lands on the focused window instead — and a Move with no destination
        # only reads the position back. Either mistake still answers Ok with
        # the coordinates you asked for, having moved nothing.
        self.req({"Move": [int(wid), [int(round(x)), int(round(y))]]})

    def move_many(self, items):
        """A whole frame of window moves on one flush.

        A glide sends every window it is animating each tick. Done one at a
        time that is a round trip apiece; written together and read back
        together it is a single one, which is the difference between a frame
        costing 0.45ms and costing 0.07ms.
        """
        for wid, x, y in items:
            self.f.write((json.dumps(
                {"Move": [int(wid), [int(round(x)), int(round(y))]]}) + "\n").encode())
        self.f.flush()
        for _ in items:
            self.f.readline()

    def focus(self, wid):
        self.req({"Focus": int(wid)})

    def opacity(self, wid, value):
        self.req({"Opacity": [int(wid), float(value)]})

    def action(self, name):
        self.req({"Action": name})


def active_output(st):
    """The output being looked at — which is not reliably the first one.

    Every screen-space calculation has to agree about which output it is
    working in. Taking the size from the active one and the camera from
    `outputs[0]` is the kind of mismatch that only shows up on a second
    monitor, and then shows up as a menu opening on the wrong screen.
    """
    outs = st.get("outputs") or []
    return next((o for o in outs if o.get("active")),
                outs[0] if outs else {"camera": [0.0, 0.0], "zoom": 1.0,
                                      "size": [1920, 1080]})


def screen(st):
    """Logical size of the active output."""
    w, h = active_output(st).get("size") or [1920, 1080]
    return float(w), float(h)


# ── Smooth flight ─────────────────────────────────────────────────────────
def fly(d, tx, ty, tz=WORK_ZOOM, rate=90):
    """Glide the view to a point. Never jumps.

    The camera is streamed as an eased path at `rate` Hz, paced against a
    deadline rather than by sleeping a fixed slice, so a flight takes the time
    it claims to even when the scheduler is busy.

    Zoom is sent exactly once, because driftwm anchors zoom on the pointer and
    re-derives the camera from it as it renders: a zoom command issued every
    frame drags the camera backwards and the flight never arrives. One command
    is also all that is needed — driftwm eases zoom itself over ~250ms.

    That single command is ordered like a real flight: zoom out before setting
    off, so you see the space you are about to cross, and zoom in on arrival.
    Afterwards the target is held briefly, because the tail of the zoom
    animation would otherwise pull the camera off the mark.

    A long flight at level zoom climbs. Two planets at working zoom are two
    screens that never overlap, so a flat hop is a featureless slide past
    nothing — the pull-back is what shows the belt passing beneath you and
    the place you left shrinking behind. Same two-command pattern the
    zooming case already proved: cruise altitude at departure, target zoom
    on the descent, and the arrival hold soaks up driftwm's easing tail.
    """
    x0, y0 = d.camera()
    z0 = d.zoom()
    dist = math.hypot(tx - x0, ty - y0)
    zooming = abs(tz - z0) > 0.005

    # Duration scales gently with distance: short hops feel immediate, long
    # journeys read as travel.
    dur = 0.45 + 0.55 * min(1.0, dist / 6000.0)

    if zooming and tz < z0:
        d.set_zoom(tz)                                 # pull back, then travel

    # Cruise altitude: high enough that departure and destination share the
    # screen, never lower than a district frame, and only when the flight is
    # long enough that flat travel would show nothing but empty sky.
    cruise = 0.0
    if not zooming and dist > 2200:
        cruise = max(MIN_FRAME_ZOOM, min(z0 * 0.85, 1400.0 / dist))
        d.set_zoom(cruise)

    steps = max(2, int(dur * rate))
    start = time.perf_counter()
    descended = cruise == 0.0
    for i in range(1, steps + 1):
        t = i / steps
        e = 0.5 - 0.5 * math.cos(math.pi * t)          # ease in-out
        d.set_camera(x0 + (tx - x0) * e, y0 + (ty - y0) * e)
        if not descended and t >= 0.62:
            d.set_zoom(tz)                             # descend on approach
            descended = True
        ahead = (start + t * dur) - time.perf_counter()
        if ahead > 0:
            time.sleep(ahead)

    if zooming and tz > z0:
        d.set_zoom(tz)                                 # settle in on arrival

    hold = 0.4 if (zooming or cruise) else 0.06
    until = time.perf_counter() + hold
    while time.perf_counter() < until:
        d.set_camera(tx, ty)
        time.sleep(1.0 / rate)


# ── Windows travel too ────────────────────────────────────────────────────
# The camera has always travelled rather than jumped; the windows had not.
# They do now, through the same machinery: an eased path streamed at 90 Hz and
# paced against a deadline, so a move takes the time it says it will.
#
# `arc` bows the path away from the Sun. A window crossing from one planet to
# another is making a transfer, and a transfer is not a straight line — the
# curve is the honest shape, and it is also the one that reads as travelling
# somewhere rather than sliding across a desk.
GLIDE_RATE = 90
ARC = 0.16             # how far a between-planets path bows outward
MOVING = runtime("sol-moving")


def glide(d, moves, arc=0.0, rate=GLIDE_RATE):
    """Move windows along eased paths. Never jumps.

    `moves` is (window id, from, to). Anything already where it belongs is
    dropped, so calling this after a tidy that changed nothing costs nothing.
    """
    plan = [(int(w), (float(a[0]), float(a[1])), (float(b[0]), float(b[1])))
            for w, a, b in moves
            if (round(a[0]), round(a[1])) != (round(b[0]), round(b[1]))]
    if not plan:
        return
    far = max(math.hypot(b[0] - a[0], b[1] - a[1]) for _, a, b in plan)
    dur = 0.20 + 0.40 * min(1.0, far / 4000.0)

    # The control point of a quadratic bend: the midpoint of the path, pushed
    # straight out from the Sun by a fraction of the distance being crossed.
    ctrl = []
    for _, a, b in plan:
        mx, my = (a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0
        out = math.hypot(mx, my) or 1.0
        k = arc * math.hypot(b[0] - a[0], b[1] - a[1])
        ctrl.append((mx + mx / out * k, my + my / out * k))

    with moving():
        steps = max(2, int(dur * rate))
        start = time.perf_counter()
        for i in range(1, steps + 1):
            t = i / steps
            e = 0.5 - 0.5 * math.cos(math.pi * t)      # ease in-out
            u = 1.0 - e
            d.move_many([(wid,
                          u * u * a[0] + 2 * u * e * c[0] + e * e * b[0],
                          u * u * a[1] + 2 * u * e * c[1] + e * e * b[1])
                         for (wid, a, b), c in zip(plan, ctrl)])
            moving.touch()          # a long glide must not go stale mid-flight
            ahead = (start + t * dur) - time.perf_counter()
            if ahead > 0:
                time.sleep(ahead)
        d.move_many([(wid, b[0], b[1]) for wid, _, b in plan])


class moving:
    """Marks the window moves as sol's own, so `sol watch` ignores them.

    The watcher cannot tell a window you dragged from a window sol is putting
    away — both arrive as the same position events. So sol says so, by keeping
    a file freshly stamped for as long as it is moving anything.

    It is a stamp rather than a flag because the events are asynchronous: the
    last few frames of a glide are still in flight when the glide itself has
    returned, and a flag cleared on the way out lets them through as though
    you had just dropped something. That is not hypothetical — it re-homed a
    window to Venus, because the far edge of Earth's grid is genuinely nearer
    Venus than Earth, which is the whole reason claims exist. So the stamp
    keeps reading busy for COOLDOWN after the last move, which is long enough
    for the tail to arrive and short enough that a real drag a moment later is
    still caught. Nothing needs deleting: a stamp nobody refreshes goes stale
    on its own, so even a crash mid-move only deafens the watcher for a blink.
    """

    COOLDOWN = 0.35
    depth = 0

    def __enter__(self):
        moving.depth += 1
        moving.touch()
        return self

    def __exit__(self, *exc):
        moving.depth -= 1
        moving.touch()          # the cooldown starts from the last move, not the first
        return False

    @staticmethod
    def touch():
        try:
            with open(MOVING, "w") as f:
                f.write(str(os.getpid()))
        except OSError:
            pass

    @staticmethod
    def busy(grace=COOLDOWN):
        try:
            return time.time() - os.path.getmtime(MOVING) < grace
        except OSError:
            return False


# ── Places ────────────────────────────────────────────────────────────────
def find_place(token):
    """A planet by number, name prefix, or the role written on its name plate."""
    t = str(token).strip().lower()
    if t in ("sun", "0", "sol", "centre", "center"):
        return SUN
    for p in PLANETS:
        if t == str(p.n) or p.name.lower().startswith(t) or t == p.role:
            return p
    return None


def nearest(x, y):
    """Nearest place to a point, and how far away it is."""
    best, bd = SUN, math.hypot(x, y)
    for p in PLANETS:
        dd = math.hypot(x - p.x, y - p.y)
        if dd < bd:
            best, bd = p, dd
    return best, bd


# ── Districts ─────────────────────────────────────────────────────────────
# A window belongs where you put it, and otherwise to the place it is nearest.
#
# Nearest alone is not enough. A planet's neighbourhood here is narrower than
# a workspace — the orbits are 820 apart while a terminal is 700 wide — so a
# tidy grid of ten windows on Earth reaches past the halfway line to Mercury,
# and windows in the far corners would defect to a planet nobody sent them to.
# No orbit spacing fixes that: Mercury is genuinely close to the Sun. So
# `send` and `arrange` write down where a window was put, and that stands as
# long as the window stays in the neighbourhood. Drag it away and it belongs
# to whatever it is nearest again.
#
# Furniture — name plates, the map, the help card — is scenery, and never
# belongs to anyone.
CLAIMS = runtime("sol-districts.json")


def is_furniture(w):
    app = str(w.get("app_id", ""))
    return w.get("is_widget") or app.startswith(("sol-", "planet-label"))


def real_windows(st):
    return [w for w in st.get("windows", []) if not is_furniture(w)]


def live_ids(st):
    """The windows that still exist — what a saved record is pruned against."""
    return {w["id"] for w in real_windows(st)}


def read_map(path, value):
    """A small map keyed by window or place number, or {} if it is not there.

    JSON has string keys, so every one of these files reads back as text and
    has to be turned into numbers again; `value` does the same for the other
    half. Missing, empty, truncated by a crash mid-write, or hand-edited into
    nonsense all mean the same thing here — sol has not been told anything —
    and all of them must end as an empty map rather than a traceback, because
    losing an arrangement is a small thing and refusing to draw the bar is not.
    """
    try:
        with open(path) as f:
            return {int(k): value(v) for k, v in json.load(f).items()}
    except (OSError, ValueError, TypeError, AttributeError):
        return {}


def write_map(path, mapping):
    """Save one, quietly. These files are conveniences; none is worth a crash."""
    try:
        with open(path, "w") as f:
            json.dump({str(k): v for k, v in mapping.items()}, f)
    except OSError:
        pass


def write_if_changed(path, text):
    """Write only when the content is new, and say whether it was.

    Three of sol's surfaces are files that something else is watching — the
    bar, the name plates, the shader — and all three get rewritten far more
    often than they actually change. Comparing first turns most of those
    writes into a read; the answer is what tells the caller whether anybody
    needs waking, which is the whole basis of the bar costing nothing when
    nothing is happening.
    """
    try:
        with open(path) as f:
            if f.read() == text:
                return False
    except OSError:
        pass                            # not there yet, or unreadable: write it
    try:
        with open(path, "w") as f:
            f.write(text)
        return True
    except OSError:
        return False


def read_claims():
    return read_map(CLAIMS, int)


def write_claims(st, claims):
    """Save the record, forgetting windows that have since closed."""
    live = live_ids(st)
    write_map(CLAIMS, {k: v for k, v in claims.items() if k in live})


# Where each window sits in its district's grid. Window id was doing this job,
# which meant the grid was fixed in the order things happened to open — fine
# until you want the thing you are working on next to the thing you are
# comparing it with. Anything sol has not been told about keeps its place by
# id, so a district nobody has rearranged looks exactly as it always did.
ORDER = runtime("sol-order.json")


def read_order():
    return read_map(ORDER, lambda v: [int(i) for i in v])


def write_order(st, order):
    live = live_ids(st)
    write_map(ORDER, {k: [i for i in v if i in live] for k, v in order.items()})


def in_order(n, wins):
    """One district's windows, in the order its grid is meant to read.

    Known windows first, in the order they were put there; anything new goes
    on the end by id, which is the order it opened in.
    """
    want = read_order().get(n, [])
    rank = {wid: i for i, wid in enumerate(want)}
    return sorted(wins, key=lambda w: (rank.get(w["id"], len(rank) + w["id"]),
                                       w["id"]))


def belongs_to(w, claims):
    """The place a window belongs to, or None if it belongs nowhere.

    Where you put it, for as long as it stays in the neighbourhood; failing
    that, whatever it is nearest, provided that is near enough to be anywhere
    at all. This is the single rule the whole district model rests on, so it
    is written once: the census and the lost-window list are the two halves of
    its answer, and when each carried its own copy of the rule they were one
    edit away from disagreeing — a window counted on Earth and reported adrift
    in the same breath.
    """
    x, y = w["position"]
    n = claims.get(w["id"], -1)
    put = PLACES[n] if 0 <= n < len(PLACES) else None
    if put is not None and math.hypot(x - put.x, y - put.y) <= DISTRICT:
        return put
    place, dd = nearest(x, y)
    return place if dd <= DISTRICT else None


def sort_out(st):
    """Work out once who holds what, and what is held by nobody.

    Both answers come from one pass over the windows, and both are cached on
    the state dict, because every caller that wants one usually wants the
    other a line later — the bar draws the tally and the adrift count from the
    same breath. `recount` is how anything that moves a window says the answer
    is stale.
    """
    if "sol_districts" not in st:
        claims = read_claims()
        by_place, lost = {}, []
        for w in real_windows(st):
            place = belongs_to(w, claims)
            if place is None:
                lost.append(w)
            else:
                by_place.setdefault(place.n, []).append(w)
        st["sol_districts"] = {n: in_order(n, wins)
                               for n, wins in by_place.items()}
        st["sol_adrift"] = lost


def recount(st):
    """Say the districts are stale — something moved, so work them out again."""
    st.pop("sol_districts", None)
    st.pop("sol_adrift", None)


def assignment(st):
    """{place number: [windows]} — who holds what, worked out once."""
    sort_out(st)
    return st["sol_districts"]


def adrift(st):
    """Windows that belong nowhere — the founding problem, still reachable.

    A window dragged into deep space belongs to no district, and so used to
    vanish from the census, the bar, the plates and the overview at once: lost
    in the way this project exists to prevent. These are those windows. The
    bar counts them, `sol list` names them, and `sol gather` brings them home
    — never automatically, because the covenant on cameras extends to windows:
    nothing moves unasked.
    """
    sort_out(st)
    return st["sol_adrift"]


def district(st, place):
    """The windows of one place, in a stable order."""
    return assignment(st).get(place.n, [])


def census(st):
    """{place number: window count} for everything that has any."""
    return {n: len(wins) for n, wins in assignment(st).items() if wins}


def plate_of(st, place):
    """A planet's name plate window, if it is running."""
    want = "planet-label-%d" % place.n
    return next((w for w in st.get("windows", []) if w.get("app_id") == want), None)


# ── Tidying ───────────────────────────────────────────────────────────────
def grid(place, wins, aspect):
    """Where each window should sit: rows of windows centred on the place.

    A grid rather than a ring of moons, for two reasons. It is the most
    compact arrangement, which matters because orbits here are 820 apart while
    a terminal is 700 wide — a planet's neighbourhood is barely wider than a
    single window, so anything that spreads bleeds into the next planet's. And
    its footprint can be shaped to the screen, so framing the district lands
    at a zoom where the windows are still usable rather than merely visible.

    Rows are filled to a target width and each keeps its own height, rather
    than every window getting a cell the size of the largest. One tall editor
    among nine terminals would otherwise inflate all ten cells and swell the
    district to no purpose. Every break point is tried; the one whose block
    best matches the shape of the screen wins.
    """
    if not wins:
        return [], 0.0, 0.0
    cells = [(w["size"][0] + GAP, w["size"][1] + GAP) for w in wins]
    notch = (2.0 * place.body + GAP, 2.0 * place.body + GAP)

    def fill(items, target):
        rows, row, wide = [], [], 0.0
        for i, (w, _) in enumerate(items):
            if row and wide + w > target:
                rows.append(row)
                row, wide = [], 0.0
            row.append(i)
            wide += w
        if row:
            rows.append(row)
        return rows

    def lay(items, rows, width):
        """Centre of every cell, relative to the middle of the block.

        Rows are justified: slack is shared into the gaps so the block has
        clean edges, but only up to one extra GAP, past which a short row is
        centred instead of being stretched into a gappy mess.
        """
        height = sum(max(items[i][1] for i in r) for r in rows)
        out = [None] * len(items)
        y = height / 2.0
        for r in rows:
            tall = max(items[i][1] for i in r)
            span = sum(items[i][0] for i in r)
            extra = min((width - span) / (len(r) - 1), GAP) if len(r) > 1 else 0.0
            x = -(span + extra * (len(r) - 1)) / 2.0
            for i in r:
                out[i] = (x + items[i][0] / 2.0, y - tall / 2.0)
                x += items[i][0] + extra
            y -= tall
        return out, height

    best = None
    for k in range(len(cells) + 1):                 # where the planet sits
        items = cells[:k] + [notch] + cells[k:]
        target = 0.0
        for w, _ in items:                          # every possible row break
            target += w
            rows = fill(items, target)
            width = max(sum(items[i][0] for i in r) for r in rows)
            centres, height = lay(items, rows, width)
            # Shape the block to the screen; keep the planet near the middle of
            # it, so the district reads as gathered around its world; and keep
            # the rows even, so no one window is left stranded on a line of
            # its own.
            off_centre = math.hypot(*centres[k]) / (math.hypot(width, height) / 2.0)
            ragged = sum(width - sum(items[i][0] for i in r) for r in rows) \
                / (width * len(rows))
            score = abs(math.log((width / height) / aspect)) \
                + 1.2 * off_centre + 2.2 * ragged
            if best is None or score < best[0]:
                best = (score, centres, k, width, height)

    _, centres, k, width, height = best
    # Anchor on the planet: its cell lands exactly on the planet itself.
    ox, oy = centres[k]
    slots = [(place.x + cx - ox, place.y + cy - oy)
             for i, (cx, cy) in enumerate(centres) if i != k]
    return slots, width, height


def tidy(d, st, place, aspect, plan=None):
    """Lay a place's windows out in a grid and lift its name plate clear.

    Past DECK windows the grid stops growing and the rest collapse into a
    stack at its corner — see `stacks` for why the line is drawn there.

    Collects its moves into `plan` rather than making them, when one is handed
    in — so a caller tidying several places animates them as a single motion
    instead of nine of them one after another.
    """
    wins = district(st, place)
    front, deck = wins[:DECK], wins[DECK:]
    slots, width, height = grid(place, front, aspect)
    claims = read_claims()
    mine = [] if plan is None else plan
    for w, (x, y) in zip(front, slots):
        mine.append((w["id"], tuple(w["position"]), (x, y)))
        w["position"] = [int(round(x)), int(round(y))]
        claims[w["id"]] = place.n     # tidied here, so it belongs here

    # The stack, off the block's bottom-right corner: each one a step further
    # back than the last, so it reads as a pile rather than a pixel.
    for i, w in enumerate(deck):
        aw, ah = w["size"]
        x = place.x + width / 2.0 + GAP + aw / 2.0 + i * DECK_STEP
        y = place.y - height / 2.0 + ah / 2.0 - i * DECK_STEP
        mine.append((w["id"], tuple(w["position"]), (x, y)))
        w["position"] = [int(round(x)), int(round(y))]
        claims[w["id"]] = place.n
    write_claims(st, claims)

    plate = plate_of(st, place)
    if plate:
        top = place.y + (height / 2.0 if wins else 0.0)
        y = top + PLATE_GAP + plate["size"][1] / 2.0 if wins else place.y + 400
        mine.append((plate["id"], tuple(plate["position"]), (place.x, y)))
        plate["position"] = [place.x, int(round(y))]
    if plan is None:
        glide(d, mine)
    return wins


# ── When a planet fills right up ──────────────────────────────────────────
# A district can only grow so far before framing it puts the windows below the
# size at which they are any use, and driftwm's IPC has no resize — position,
# opacity, focus and close are the whole toolkit — so shrinking them to fit is
# not on the table. What is left is to stop laying all of them out.
#
# So the grid holds the DECK most recently used and the rest collapse into a
# stack at its corner: still there, still counted, still reachable with
# mod+n, but out of the way and visibly behind. Touch one and it comes back
# to the front, which makes the grid an LRU you can see. The order that
# `sol shift` and a drag-to-reorder write is the same order that decides
# this, so recency and arrangement are one mechanism rather than two.
DECK = 12          # how many a grid holds before the rest start stacking
DECK_STEP = 26     # how far each one sits behind the one in front
DECK_DIM = 0.45    # and how far back it reads


def stacks(st):
    """{window id: how deep in its planet's stack} for everything collapsed."""
    deep = {}
    for wins in assignment(st).values():
        for i, w in enumerate(wins[DECK:]):
            deep[w["id"]] = i
    return deep


def spotlight(d, st, focused=None):
    """Bring the focused window forward and set the rest a touch back."""
    deep = stacks(st)
    for w in real_windows(st):
        if w["id"] in deep:
            d.opacity(w["id"], max(0.20, DECK_DIM - 0.04 * deep[w["id"]]))
            continue
        lit = (w["id"] == focused) if focused is not None else w.get("is_focused")
        d.opacity(w["id"], 1.0 if lit else DIM)


def promote(st, place, wid):
    """Bring a window to the front of its grid — what touching one means."""
    ids = [w["id"] for w in district(st, place) if w["id"] != wid]
    order = read_order()
    order[place.n] = [wid] + ids
    write_order(st, order)
    recount(st)


# ── The card each district sits on ────────────────────────────────────────
# The shader cannot see the windows, so `sol` tells it: the rectangles are
# written between markers in sol.glsl and the config is reloaded, which is
# cheap and — unlike a restart — keeps the camera, the windows and their
# opacity exactly as they were. Everything outside the markers is left alone,
# and a shader without them simply gets no cards.
CARD_HEAD = "// ── districts ──"
CARD_TAIL = "// ── end districts ──"


def bounds(st, place, skip=None):
    """The rectangle a district occupies: its windows and its world.

    `skip` leaves one window out of the reckoning. The drag-catcher needs
    the card as it stood before the drag — a box that includes the window
    you are holding stretches to wherever you drop it, and every drop in
    the neighbourhood then reads as "still inside".
    """
    wins = [w for w in district(st, place) if w["id"] != skip]
    if not wins:
        return None
    boxes = [(w["position"], w["size"]) for w in wins]
    boxes.append(((place.x, place.y), (place.body * 2, place.body * 2)))
    x0 = min(p[0] - s[0] / 2.0 for p, s in boxes) - CARD_PAD
    x1 = max(p[0] + s[0] / 2.0 for p, s in boxes) + CARD_PAD
    y0 = min(p[1] - s[1] / 2.0 for p, s in boxes) - CARD_PAD
    y1 = max(p[1] + s[1] / 2.0 for p, s in boxes) + CARD_PAD
    return (x0 + x1) / 2.0, (y0 + y1) / 2.0, (x1 - x0) / 2.0, (y1 - y0) / 2.0


def write_cards(d, st):
    try:
        with open(SHADER) as f:
            src = f.read()
    except OSError:
        return
    head, mark, rest = src.partition(CARD_HEAD)
    _, mark2, tail = rest.partition(CARD_TAIL)
    if not mark or not mark2:
        return

    lines = [CARD_HEAD]
    for i, p in enumerate(PLACES):
        box = bounds(st, p)
        if box:
            # Shader space is the canvas with y negated.
            lines.append("const vec4 D%d = vec4(%.1f, %.1f, %.1f, %.1f);"
                         % (i, box[0], -box[1], box[2], box[3]))
        else:
            lines.append("const vec4 D%d = vec4(0.0, 0.0, 0.0, 0.0);" % i)
    new = head + "\n".join(lines) + "\n" + CARD_TAIL + tail
    if new == src:
        return
    try:
        with open(SHADER, "w") as f:
            f.write(new)
    except OSError:
        return
    d.action("reload-config")


def frame(st, place, aspect_wh):
    """(x, y, zoom) that shows everything at a place — or just the place."""
    ow, oh = aspect_wh
    box = bounds(st, place)
    if not box:
        return float(place.x), float(place.y), WORK_ZOOM

    # The card is what you are looking at, so frame it whole, name plate and all.
    x0, x1 = box[0] - box[2], box[0] + box[2]
    y0, y1 = box[1] - box[3], box[1] + box[3]
    plate = plate_of(st, place)
    if plate:
        (px, py), (pw, ph) = plate["position"], plate["size"]
        x0, x1 = min(x0, px - pw / 2.0), max(x1, px + pw / 2.0)
        y0, y1 = min(y0, py - ph / 2.0), max(y1, py + ph / 2.0)

    # Centre on the district, not on its union with the name plate — and then
    # pull back far enough that the plate is in shot anyway.
    #
    # The plate is centred on the planet, and a planet sits at one edge of its
    # district rather than in the middle of it: the grid is laid out *beside*
    # the world, because the world is one cell of it. So the union of the two
    # boxes has its centre somewhere off in the plate's direction, and every
    # arrival puts the windows — the thing you came to look at — visibly off
    # to one side. That is the kind of wrongness you notice immediately and
    # cannot name, and it was worth two hundred pixels of it to find.
    cx, cy = box[0], box[1]
    hx = max(box[2], abs(x0 - cx), abs(x1 - cx))
    hy = max(box[3], abs(y0 - cy), abs(y1 - cy))
    z = min(ow / max(2.0 * hx, 1.0), oh / max(2.0 * hy, 1.0)) * 0.92
    return cx, cy, max(MIN_FRAME_ZOOM, min(WORK_ZOOM, z))


# ── Commands ──────────────────────────────────────────────────────────────
def cmd_goto(args):
    p = find_place(args[0]) if args else None
    if not p:
        sys.exit("sol goto: name a planet (1-8, Mercury..Neptune, a role, or sun)")
    d = Drift()
    st = d.state()
    fx, fy, fz = frame(st, p, screen(st))

    # A district too big to show at working zoom gets framed. Ask for the same
    # planet again from that overview and you dive in to get to work.
    if fz < WORK_ZOOM:
        cx, cy = d.camera()
        if math.hypot(cx - fx, cy - fy) < 200 and abs(d.zoom() - fz) < 0.05:
            wins = district(st, p)
            w = next((w for w in wins if w.get("is_focused")), wins[0] if wins else None)
            if w:
                d.focus(w["id"])
                spotlight(d, st, w["id"])
                fly(d, w["position"][0], w["position"][1], WORK_ZOOM)
                return
    fly(d, fx, fy, fz)
    if fz < WORK_ZOOM and p is not SUN:
        # Framed rather than landed: the second press is the half of the
        # habit nobody guesses, so this is the moment to say it.
        say("goto %d · mod+%d again drops in" % (p.n, p.n))


def cmd_dive(args):
    """Go to wherever the view already is — and again, into its windows.

    What a pinch-out means when the canvas has places in it: not "zoom in a
    bit" but "take me into the one I am looking at". It is `goto` pointed at
    the nearest place, so a second pinch drops you into a window exactly as a
    second `mod+3` would.
    """
    here, _ = nearest(*Drift().camera())
    cmd_goto(["sun" if here is SUN else str(here.n)])


def cmd_hop(args):
    direction = (args[0] if args else "out").lower()
    d = Drift()
    x, y = d.camera()
    here, dist = nearest(x, y)
    idx = here.n
    if direction in ("in", "sunward", "left", "prev"):
        nxt = idx - 1
    else:
        nxt = idx + 1
    nxt = max(0, min(8, nxt))
    p = PLACES[nxt]
    st = d.state()
    fly(d, *frame(st, p, screen(st)))


def cmd_system(args):
    """Frame the whole solar system, centred on the Sun.

    driftwm clamps zoom-out to half the fit of the real windows on the canvas,
    which is why the planet name plates are ordinary windows: they hold the
    canvas open wide enough for this view to exist.
    """
    d = Drift()
    st = d.state()
    w, h = screen(st)
    z = min(w, h) / (2.3 * SYSTEM_R)
    fly(d, 0, 0, max(0.05, z))


def cmd_first_light(args):
    """The virgin session arrives instead of starting. Fires once, ever.

    The autostart promises "a terminal on Earth, so the first thing you see
    is home" — and then the camera wakes wherever driftwm's default put it,
    with home 2,600 canvas units out of frame. This closes that gap the way
    everything here moves: one flight, asked for by being in autostart, and
    never again — the marker outlives reboots, so an existing user never
    sees it at all.
    """
    mark = os.path.join(STATE, "first-light")
    if os.path.exists(mark):
        return
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(mark, "w") as f:
            f.write("the first session flew home\n")
    except OSError:
        return
    d = Drift()
    # The session is still assembling around us — plates, bars, the home
    # terminal. Wait for home to exist before framing it, briefly.
    deadline = time.time() + 12.0
    while time.time() < deadline:
        st = d.state()
        if any(w.get("app_id") == "home-term" for w in st.get("windows", [])):
            break
        time.sleep(0.25)
    time.sleep(0.6)                       # let driftwm place what just mapped
    st = d.state()
    home = find_place("home") or SUN
    fly(d, *frame(st, home, screen(st)))


def cmd_tour(args):
    """An asked-for first flight, narrated by the footer.

    Five legs over the places that matter, each named in the footer with the
    gesture and the key that would have made it — so by the end the
    keybinding card is a list of places you have been rather than a table.

    Interruptible on the planetarium's precedent: touch the view between
    legs and the tour yields immediately. It is your desk, not a ride.
    """
    d = Drift()
    st = d.state()
    ow, oh = screen(st)
    home = find_place("home") or PLANETS[2]
    outward = PLANETS[min(home.n, 7)]        # the next planet out from home
    legs = [
        ("the whole system · four fingers up, or mod+u",
         lambda: fly(d, 0, 0, max(0.05, min(ow, oh) / (2.3 * SYSTEM_R)))),
        ("the Sun is home base · mod+0",
         lambda: fly(d, *frame(d.state(), SUN, (ow, oh)))),
        ("each planet is a workspace · mod+%d is %s" % (home.n, home.name),
         lambda: fly(d, *frame(d.state(), home, (ow, oh)))),
        ("outward is away from your attention · mod+→, or four fingers left",
         lambda: fly(d, *frame(d.state(), outward, (ow, oh)))),
        ("and home again · right-click the sky for the menu, mod+/ for every key",
         lambda: fly(d, *frame(d.state(), home, (ow, oh)))),
    ]
    where = None
    for text, go in legs:
        if where is not None:
            cx, cy = d.camera()
            if math.hypot(cx - where[0], cy - where[1]) > 60:
                return                       # you took the controls; it yields
        footer(text)
        try:
            go()
        except KeyboardInterrupt:
            return
        where = d.camera()
        time.sleep(2.2)
    footer("the tour · mod+/ has every key")


def cmd_arrange(args):
    """Tidy a district into a grid — the answer to ten terminals in a heap."""
    d = Drift()
    st = d.state()
    ow, oh = screen(st)
    where = args[0] if args else None
    if where in ("all", "*"):
        places = PLACES
    else:
        p = find_place(where) if where else nearest(*d.camera())[0]
        if not p:
            sys.exit("sol arrange: unknown place")
        places = [p]
    plan = []
    for p in places:
        tidy(d, st, p, ow / oh, plan)
    glide(d, plan)                    # every district settles as one motion
    spotlight(d, st)
    write_plates(st)
    write_cards(d, st)
    if len(places) == 1:
        fly(d, *frame(st, places[0], (ow, oh)))


def cmd_step(args, step=1):
    """Focus the next window of a place, and fly to it.

    Named, it steps through that place; unnamed, through wherever the view
    already is. The menu needs the named form: pointing at Jupiter from
    across the system and asking to step through its windows must step
    through Jupiter's, not through whatever the camera is nearest.
    """
    d = Drift()
    st = d.state()
    ow, oh = screen(st)
    x, y = d.camera()
    here = find_place(args[0]) if args else nearest(x, y)[0]
    if not here:
        sys.exit("sol: unknown place '%s'" % args[0])
    wins = district(st, here)
    if not wins:
        sys.exit("sol: no windows at %s" % here.name)
    cur = next((w for w in wins if w.get("is_focused")), None)
    if cur is None:
        # Focus is elsewhere: start from whatever is nearest the view.
        w = min(wins, key=lambda w: math.hypot(w["position"][0] - x, w["position"][1] - y))
    else:
        w = wins[(wins.index(cur) + step) % len(wins)]

    # Stepping onto something in the stack lifts it back into the grid. Only
    # then — stepping across the grid itself must not churn the order, or the
    # next press would set off from somewhere you did not leave it.
    if w["id"] in stacks(st):
        promote(st, here, w["id"])
        with moving():
            plan = []
            tidy(d, st, here, ow / oh, plan)
            glide(d, plan)
        write_cards(d, st)
        w = next(q for q in district(st, here) if q["id"] == w["id"])

    d.focus(w["id"])
    spotlight(d, st, w["id"])
    fly(d, w["position"][0], w["position"][1], WORK_ZOOM)


def cmd_send(args):
    if not args:
        sys.exit("sol send: name a planet")
    p = find_place(args[0])
    if not p:
        sys.exit("sol send: unknown planet")
    d = Drift()
    st = d.state()
    win = next((w for w in real_windows(st) if w.get("is_focused")), None)
    if not win:
        sys.exit("sol send: no focused window")
    was = next((q for q in PLACES if win in district(st, q)), None)
    ow, oh = screen(st)
    # Land it on the planet, then tidy — so sending ten windows to one planet
    # leaves a grid rather than ten windows on the same pixel. The landing is
    # only the bookkeeping: `origin` is put back below so the window is seen
    # to cross, on the arc it would really have taken.
    origin = tuple(win["position"])
    d.move(win["id"], p.x, p.y)
    win["position"] = [p.x, p.y]
    claims = read_claims()
    claims[win["id"]] = p.n
    write_claims(st, claims)
    recount(st)                            # it has a new home; work it out again
    plan = []
    tidy(d, st, p, ow / oh, plan)
    if was and was.n != p.n:
        tidy(d, st, was, ow / oh, plan)    # and the district it left behind
    plan = [(w, origin if w == win["id"] else a, b) for w, a, b in plan]
    glide(d, plan, arc=ARC if was and was.n != p.n else 0.0)
    spotlight(d, st)
    write_plates(st)
    write_cards(d, st)
    if "--stay" not in args:
        fly(d, *frame(st, p, (ow, oh)))


def _resettle(d, st, wins, dst, others=()):
    """Send a batch of windows to one place, on the arcs they would take.

    The shared tail of `gather` and `sweep`: claim each window for the
    destination, tidy there (and any district that lost members), and glide
    everything from where it really was — the same journey a drag would make,
    run as one motion.
    """
    ow, oh = screen(st)
    claims = read_claims()
    origins = {}
    for w in wins:
        origins[w["id"]] = tuple(w["position"])
        d.move(w["id"], dst.x, dst.y)
        w["position"] = [dst.x, dst.y]
        claims[w["id"]] = dst.n
    write_claims(st, claims)
    recount(st)
    plan = []
    tidy(d, st, dst, ow / oh, plan)
    for p in others:
        if p.n != dst.n:
            tidy(d, st, p, ow / oh, plan)
    plan = [(wid, origins.get(wid, a), b) for wid, a, b in plan]
    glide(d, plan, arc=ARC)
    spotlight(d, st)
    write_plates(st)
    write_cards(d, st)


def cmd_gather(args):
    """Bring every adrift window in — nothing on this canvas is ever lost.

    To the Sun unless you name a place, because the Sun is the inbox: the
    one place with no role to contaminate. Never automatic — the covenant
    on cameras extends to windows — so this is the verb you say when the
    bar's "adrift" count should be zero again.
    """
    d = Drift()
    st = d.state()
    dst = find_place(args[0]) if args else SUN
    if not dst:
        sys.exit("sol gather: unknown place '%s'" % args[0])
    lost = adrift(st)
    if not lost:
        print("nothing adrift")
        return
    _resettle(d, st, lost, dst)
    print("gathered %s to %s" % (windows_word(len(lost)), dst.name))


def cmd_sweep(args):
    """Drain a planet's stack to the archive — Neptune's role, as a verb.

    The grid holds the DECK most recent windows and the rest collapse into a
    stack you page through. Sweep takes the stack — the windows the planet
    has visibly stopped needing — and files them on Neptune in one motion,
    so a crowded planet ends tidy without closing anything. Named places
    override both ends: `sol sweep 5 2` drains Jupiter's stack to Venus.
    """
    d = Drift()
    st = d.state()
    src = find_place(args[0]) if args else nearest(*d.camera())[0]
    if not src:
        sys.exit("sol sweep: unknown place '%s'" % args[0])
    dst = find_place(args[1]) if len(args) > 1 else find_place("archive")
    if not dst:
        sys.exit("sol sweep: unknown place '%s'" % args[1])
    over = district(st, src)[DECK:]
    if not over:
        print("nothing stacked at %s" % src.name)
        return
    _resettle(d, st, list(over), dst, others=[src])
    print("swept %s from %s to %s" % (windows_word(len(over)), src.name, dst.name))


# ── Catching a drag ───────────────────────────────────────────────────────
# driftwm already lets you pick a window up and put it anywhere on the canvas.
# What it cannot know is that Jupiter is a place. So `sol watch` subscribes to
# the compositor's event stream, waits for a dragged window to come to rest,
# and reads what the drop meant: another planet's district, a different slot
# in the one it was already in, or open space.
#
# Sol's own moves arrive on the same stream and look exactly like a drag,
# which is what the `moving` lock is for.
SETTLE = 0.20          # nothing has moved for this long, so the drag is over


class Stream:
    """Raw line reader over an IPC socket.

    Events arrive in bursts — a drag produces one a frame — so several land in
    a single read. A buffered readline() would leave the extras invisible to
    select(), which watches the descriptor and not Python's buffer: the same
    trap the overview's keyboard fell into.
    """

    def __init__(self, sock):
        self.sock = sock
        self.buf = b""

    def take(self, timeout):
        import select
        if b"\n" not in self.buf:
            r, _, _ = select.select([self.sock], [], [], timeout)
            if not r:
                return []
            chunk = self.sock.recv(1 << 16)
            if not chunk:
                raise EOFError("driftwm closed the connection")
            self.buf += chunk
        parts = self.buf.split(b"\n")
        self.buf = parts.pop()
        out = []
        for line in parts:
            try:
                got = json.loads(line.decode().strip() or "0")
            except ValueError:
                continue
            if isinstance(got, dict) and got.get("State"):
                out.append(got["State"])
        return out


def shrug(doing, why):
    """Survive a fault, but not in silence.

    `sol watch` runs for the whole session, so one odd drop must not be the
    end of it — but a handler that swallows without a word is how a real fault
    hides for weeks, and "windows sometimes don't land right" is a bug report
    with nothing in it. This process's stderr is driftwm's log, which is where
    `sol doctor` already sends people, so the shrug is at least audible.
    """
    sys.stderr.write("sol watch: %s failed: %s: %s\n"
                     % (doing, type(why).__name__, why))
    sys.stderr.flush()


def refresh(d, st=None):
    """Bring the bar and the plates up to date, and wake whoever shows them.

    The two surfaces are written together because they are one thought — what
    is where — and woken separately because they have different readers and
    change at different times: the plates only when a district's count moves,
    the bar also when the camera does.
    """
    st = d.state() if st is None else st
    # The camera and the zoom come out of the state we already have. Asking
    # for them separately is two more round trips for two numbers that are
    # sitting in front of us, and on the watcher's beat that is four hundred
    # needless exchanges a minute.
    out = active_output(st)
    cam = tuple(out.get("camera") or (0.0, 0.0))
    z = out.get("zoom") or 1.0
    place, on_it, n = whereabouts(st, cam, z)
    if write_plates(st):
        wake("plates", signal.SIGUSR1)
    if write_bar(st, place, on_it, n, z)[1]:
        wake("waybar", signal.SIGRTMIN + BAR_SIGNAL)


# How often `sol watch` refreshes the bar, and why there are two answers.
#
# When the compositor has just told us something moved, the bar should follow
# at once — but a drag delivers an event a frame, so redrawing ninety times a
# second to say the same thing would be the polling this replaced, only
# faster. BUSY is the floor between those two mistakes.
#
# When nothing is happening there is no event to answer, and the only thing
# still changing is the footer counting the seconds since sol last did
# something. That wants a clock, and the cheapest clock that keeps the text
# honest is one tick a second — the rate the bar used to poll at, except that
# this one is a single loop asking for state rather than twelve processes.
BUSY, IDLE = 0.1, 1.0


def cmd_watch(args):
    """Finish the journey for any window you drop somewhere new.

    And keep the bar and the plates current, because this is the one process
    that is already awake and already knows when the world moved. See
    BAR_SIGNAL for why that job landed here.
    """
    act, ear = Drift(), Drift()
    ear.f.write(b'"Subscribe"\n')
    ear.f.flush()
    ear.f.readline()                       # the Ok for the subscription itself
    ear.s.settimeout(None)
    stream = Stream(ear.s)

    # `unsettled`, not `adrift`: these are windows still in motion, whereas
    # adrift() names the ones that came to rest outside every district. Two
    # different ideas that both wanted the same word, and the module-level one
    # is a function this loop would shadow.
    seen, unsettled, lift, focused = {}, {}, set(), None
    beat = 0.0
    while True:
        try:
            states = stream.take(0.05)
        except (EOFError, OSError):
            return
        now = time.time()
        for st in states:
            at_now = next((w["id"] for w in real_windows(st)
                           if w.get("is_focused")), None)
            if at_now is not None and at_now != focused:
                focused = at_now
                lift.add(at_now)           # if it was stacked, it comes forward
            if moving.busy():
                # sol is animating: take every position as read, and forget
                # anything that looked like a drag while it was doing so.
                seen = {w["id"]: (tuple(w["position"]), now)
                        for w in real_windows(st)}
                unsettled.clear()
                continue
            for w in real_windows(st):
                wid, at = w["id"], tuple(w["position"])
                was = seen.get(wid)
                if was is None or at != was[0]:
                    seen[wid] = (at, now)
                if was is not None and at != was[0]:
                    unsettled[wid] = at
        if moving.busy():
            continue
        for wid in [k for k in list(unsettled)
                    if now - seen.get(k, (None, now))[1] >= SETTLE]:
            unsettled.pop(wid, None)
            try:
                settle(act, wid)
            except Exception as e:         # a daemon that dies on one odd drop
                shrug("settling window %d" % wid, e)   # is worse than one that shrugs
        while lift:
            wid = lift.pop()
            try:
                raise_up(act, wid)
            except Exception as e:
                shrug("raising window %d" % wid, e)

        # The bar and the plates: promptly when the world moved, lazily when
        # it did not. See BUSY/IDLE.
        if now - beat >= (BUSY if states else IDLE):
            beat = now
            try:
                refresh(act, states[-1] if states else None)
            except Exception as e:
                shrug("refreshing the bar", e)


def raise_up(d, wid):
    """A stacked window has been touched: lift it back into the grid."""
    st = d.state()
    if wid not in stacks(st):
        return
    place = next((p for p in PLACES
                  if any(w["id"] == wid for w in district(st, p))), None)
    if not place:
        return
    ow, oh = screen(st)
    promote(st, place, wid)
    with moving():
        plan = []
        tidy(d, st, place, ow / oh, plan)
        glide(d, plan)
    spotlight(d, st, wid)
    write_plates(st)
    write_cards(d, st)


def slot_for(place, wins, drop, aspect):
    """The index of the grid slot nearest a point — where a drop belongs."""
    slots, _, _ = grid(place, wins, aspect)
    if not slots:
        return 0
    return min(range(len(slots)),
               key=lambda i: math.hypot(slots[i][0] - drop[0],
                                        slots[i][1] - drop[1]))


def put_at(st, place, wid, index):
    """Write down that this window holds this place in the grid's order."""
    ids = [w["id"] for w in district(st, place) if w["id"] != wid]
    ids.insert(max(0, min(index, len(ids))), wid)
    order = read_order()
    order[place.n] = ids
    write_order(st, order)
    recount(st)                            # the order changed; work it out again


def settle(d, wid):
    """A window has been put down. Work out what that meant, and finish it."""
    st = d.state()
    w = next((q for q in real_windows(st) if q["id"] == wid), None)
    if not w:
        return
    drop = tuple(w["position"])
    ow, oh = screen(st)
    aspect = ow / oh
    claims = read_claims()
    home = claims.get(wid)
    was = PLACES[home] if home is not None and 0 <= home < len(PLACES) else None

    # Did it leave? The card is the answer, not the nearest planet centre.
    #
    # Nearest alone gets this badly wrong, because a tidy district reaches
    # past the halfway line to its neighbours: the left column of Earth's grid
    # is genuinely nearer Venus than Earth. Deciding by centres would hand
    # those windows to Venus the moment anything nudged them — which is
    # exactly what it did, quietly, until a strip of counts in the bar gave it
    # away. The card is the district you can see, so dropping anywhere on it
    # means "put it here", and only leaving it means "it lives somewhere else
    # now".
    box = bounds(st, was, skip=wid) if was else None
    stayed = box is not None and abs(drop[0] - box[0]) <= box[2] \
        and abs(drop[1] - box[1]) <= box[3]

    if stayed:
        reorder(d, st, was, wid, drop, aspect)
        return

    place, dist = nearest(*drop)
    if dist > DISTRICT:                    # left in open space: it is adrift
        claims.pop(wid, None)
        write_claims(st, claims)
        if was:
            with moving():
                recount(st)
                plan = []
                tidy(d, st, was, aspect, plan)
                glide(d, plan)
            write_plates(st)
            write_cards(d, st)
        return

    if was and was.n == place.n:
        reorder(d, st, place, wid, drop, aspect)
    else:
        handoff(d, st, place, wid, drop, aspect, was)


def reorder(d, st, place, wid, drop, aspect):
    """Dropped inside its own district: give it the slot it was dropped on."""
    wins = district(st, place)
    if len(wins) < 2:
        with moving():
            glide(d, [(wid, drop, (w["position"][0], w["position"][1]))
                      for w in wins if w["id"] == wid])
        return
    put_at(st, place, wid, slot_for(place, wins, drop, aspect))
    with moving():
        plan = []
        tidy(d, st, place, aspect, plan)
        glide(d, plan)
    write_cards(d, st)


def handoff(d, st, place, wid, drop, aspect, was):
    """Dropped on another planet: make room first, then let it cross.

    Two motions, in the order a room makes space for somebody. Everything
    already there slides apart while the newcomer waits where it was put down,
    and only then does it travel — on an arc away from the Sun, because what
    it is doing is a transfer between two orbits and a transfer is not a
    straight line. Behind it, the district it left closes the gap.
    """
    claims = read_claims()
    claims[wid] = place.n
    write_claims(st, claims)
    recount(st)
    put_at(st, place, wid, slot_for(place, district(st, place), drop, aspect))

    with moving():
        plan = []
        tidy(d, st, place, aspect, plan)
        if was and was.n != place.n:
            tidy(d, st, was, aspect, plan)     # and the one it left behind
        crossing = [m for m in plan if m[0] == wid]
        glide(d, [m for m in plan if m[0] != wid])    # the room makes space
        glide(d, crossing, arc=ARC)                   # then it crosses
    spotlight(d, st)
    write_plates(st)
    write_cards(d, st)


def cmd_shift(args, step=1):
    """Move the focused window one slot along its district's grid."""
    d = Drift()
    st = d.state()
    ow, oh = screen(st)
    win = next((w for w in real_windows(st) if w.get("is_focused")), None)
    if not win:
        sys.exit("sol shift: no focused window")
    place = next((p for p in PLACES if win in district(st, p)), None)
    if not place:
        sys.exit("sol shift: that window is not at a planet")
    wins = district(st, place)
    if len(wins) < 2:
        return
    i = [w["id"] for w in wins].index(win["id"])
    put_at(st, place, win["id"], (i + step) % len(wins))
    with moving():
        plan = []
        tidy(d, st, place, ow / oh, plan)
        glide(d, plan)
    write_cards(d, st)


def whereabouts(st, cam, zoom):
    """(place, on_it, how many windows it has) for the current view.

    Arrival is judged in screen terms, not canvas terms: pulled back far
    enough that a planet fills the view, you are at that planet even though
    the numbers say you are thousands of pixels away.
    """
    ow, oh = screen(st)
    x, y = cam
    counts = census(st)
    if math.hypot(x, y) < SYSTEM_R and ow / max(zoom, 0.01) > 1.7 * SYSTEM_R:
        return None, False, sum(counts.values())          # the whole system
    # Standing anywhere on a district's own card is being at that place, however
    # far the planet itself is — a window at the far corner of Earth's workspace
    # is still on Earth, not adrift.
    for p in PLACES:
        box = bounds(st, p)
        if box and abs(x - box[0]) <= box[2] and abs(y - box[1]) <= box[3]:
            return p, True, counts.get(p.n, 0)
    place, dist = nearest(x, y)
    reach = max(ARRIVE_RADIUS, min(oh, ow) / (2.0 * max(zoom, 0.01)) * 0.55)
    return place, dist <= reach, counts.get(place.n, 0)


# How near the pointer has to be to a planet to be pointing at it, measured
# on the screen rather than on the canvas. A canvas distance cannot serve
# both altitudes: 900 units is half a screen at working zoom and four pixels
# across the whole-system view. So the reach is the more generous of the two —
# the district you are standing in when you are in one, and a comfortable
# target around the planet itself when the whole system is in view.
POINT_REACH = 110      # screen pixels around a planet that count as pointing at it


def place_under(st, at, zoom):
    """(place, how many windows it has) for the place under a canvas point.

    The camera answers "where am I"; this answers "what did you click on",
    and out at the whole-system view those are different questions with
    different answers. Pointing at nothing in particular — the sky between
    the orbits — is not a place, and returns None.
    """
    x, y = at
    counts = census(st)
    for p in PLACES:
        box = bounds(st, p)
        if box and abs(x - box[0]) <= box[2] and abs(y - box[1]) <= box[3]:
            return p, counts.get(p.n, 0)
    p, dist = nearest(x, y)
    reach = max(ARRIVE_RADIUS, POINT_REACH / max(zoom, 0.01))
    return (p, counts.get(p.n, 0)) if dist <= reach else (None, sum(counts.values()))


def windows_word(n):
    return "%d window%s" % (n, "" if n == 1 else "s")


# The name plates show a live tally, but they must not cost anything to keep
# live: eight terminals each waking a Python process every few seconds would
# burn more CPU than the whole canvas. So the plates read one small file, and
# `sol here` — which waybar already runs once a second, and which has the
# census in hand anyway — is what writes it.
PLATES = runtime("sol-plates")


def held(n):
    """How a count reads once some of it has stacked: "10 + 7"."""
    return "%d + %d" % (DECK, n - DECK) if n > DECK else "%d" % n


def plate_line(p, n):
    """The line a planet's name plate shows: "3  E A R T H  home · 10 + 7"."""
    tail = "%s · %s" % (p.role, held(n)) if n else p.role
    return "  %d   %s   \033[2m%s\033[0m" % (p.n, " ".join(p.name.upper()), tail)


def write_plates(st):
    """Refresh the name plates, and say whether they actually moved."""
    counts = census(st)
    text = "".join(plate_line(p, counts.get(p.n, 0)) + "\n" for p in PLANETS)
    return write_if_changed(PLATES, text)


def cmd_plate(args):
    """Print one plate's line — what the plates read from the file."""
    p = find_place(args[0]) if args else None
    if not p:
        sys.exit("sol plate: name a planet")
    print(plate_line(p, census(Drift().state()).get(p.n, 0)))


# ── The bar ───────────────────────────────────────────────────────────────
# The bar borrows the shape of the macOS menu bar, because the mapping is
# exact: the planet you are on is the frontmost application. So ☉ opens the
# menu where  would be, the place is named in bold where the app name goes,
# what it holds reads as that app's menus, and the status glyphs and the
# clock sit on the right in that order.
#
# Three of those modules want the same census, and none of them should pay
# for it. `sol here` is the one that asks — it already runs once a second for
# the plates — and it leaves the finished JSON in one file for the others to
# read. `sol bar strip` is then a seek and a print: no IPC, no state, no cost.
BAR = runtime("sol-bar")

# ── Waking the surfaces, rather than being asked ──────────────────────────
# The bar used to be polled. Twelve waybar modules, once a second, each one a
# shell and a sed to re-read a file that had not changed — nineteen processes
# a second and five per cent of a core, spent almost entirely on discovering
# that nothing had happened. On four cores that churn is not free, and it is
# paid whether or not anybody is looking.
#
# So sol pushes instead. `sol watch` is already subscribed to the compositor
# for the drag-catcher, so it is already awake and already knows when the
# world moved: it writes the files and taps the readers on the shoulder, and
# they read only when there is something new to read. Idle costs nothing, and
# the bar stops being up to a second out of date — a click on ③ lights the
# ring it belongs to now, rather than eventually.
BAR_SIGNAL = 8            # waybar carries "signal": 8 on every sol module


# Who is allowed to receive each nudge. Matching on the command line alone is
# not enough and the difference is not cosmetic: a plate is `sh label.sh 3
# EARTH home` running inside `foot -a planet-label-3 … label.sh 3 EARTH home`,
# so the marker appears in both — and the default action for SIGUSR1 is to
# terminate. Signalling on the command line alone would have closed all eight
# plate windows every time a district's count changed. So the name of the
# program itself has to agree too.
READERS = {
    "waybar": ("waybar", ("waybar",)),
    "plates": ("label.sh", ("sh", "dash", "bash", "ash", "busybox")),
}


def waking(who, ttl=15.0, _seen={}):
    """The processes to wake for `who`, looked up rarely.

    Reading /proc is cheap but not free, and these readers are started once at
    login and outlive everything, so the answer keeps. Re-checked now and then
    rather than never, because waybar can be restarted underneath us, and a
    bar that has quietly stopped updating is exactly the fault nobody reports
    — they just say it feels broken.
    """
    now = time.time()
    got = _seen.get(who)
    if got and now - got[0] < ttl:
        return got[1]
    marker, comms = READERS[who]
    want = marker.encode()
    pids = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open("/proc/%s/cmdline" % entry, "rb") as f:
                if want not in f.read():
                    continue
            with open("/proc/%s/comm" % entry) as f:
                if f.read().strip() in comms:
                    pids.append(int(entry))
        except OSError:
            continue                    # it ended while we were reading it
    _seen[who] = (now, pids)
    return pids


def wake(who, sig):
    """Tell whoever is showing this that it has changed."""
    for pid in waking(who):
        try:
            os.kill(pid, sig)
        except OSError:
            pass                        # gone since we looked; the next scan refinds it


# where/holding/strip/last first, then one line per planet — the bar's strip
# is eight separate buttons now, because the muscle memory for "click a
# number, go to that workspace" lives in the bar and nowhere else, and a
# single waybar module cannot know which number you clicked.
BAR_PARTS = ("where", "holding", "strip", "last",
             "p1", "p2", "p3", "p4", "p5", "p6", "p7", "p8")

# The footer's idle half: the last thing sol was asked to do. Every command
# leaves its name here on the way out, whoever asked for it — a keybinding, the
# menu, the command line itself — so the bottom of the screen is a record of
# what just happened rather than a strip of wasted pixels. The ones that poll
# say nothing, or the footer would only ever read "here".
LOG = runtime("sol-last")
# `prompt` is quiet because it records the command you typed into it, and
# main() must not then overwrite that with the word "prompt". `first-light`
# and `tour` are quiet because they write the footer themselves — the first
# so the fresh-install hint below survives the arrival, the second because
# its whole narration runs through the footer.
QUIET = {"here", "bar", "plate", "list", "watch", "map", "help", "menu",
         "prompt", "first-light", "tour", "doctor"}

# What survives reboots: ~/.local/state/sol. The runtime files above are
# per-boot on purpose; these two facts are not. `first-light` is whether the
# virgin session has flown home; `spoken` is whether sol has ever run a
# command for this user — the moment the footer stops teaching.
STATE = os.path.expanduser(os.path.join(
    os.environ.get("XDG_STATE_HOME") or "~/.local/state", "sol"))
SPOKEN = os.path.join(STATE, "spoken")


def key_of(argv):
    """The keybinding that would have done what was just done.

    The context menu's accelerator column is the doctrine — a surface
    teaches you to stop needing it — and the footer is where every mouse
    habit reports. So a click on ③ in the bar leaves "goto 3 · mod+3"
    behind it, and the key rides along until it is the habit.
    """
    cmd, a = argv[0], (argv[1] if len(argv) > 1 else "")
    if cmd == "goto":
        p = find_place(a)
        return "" if not p else ("mod+0" if p is SUN else "mod+%d" % p.n)
    if cmd == "send":
        p = find_place(a)
        return "mod+ctrl+%d" % p.n if p and p is not SUN else ""
    if cmd == "hop":
        return "mod+←" if a.startswith(("in", "sun", "le", "pr")) else "mod+→"
    if cmd == "shift":
        return "mod+shift+←" if a.startswith("b") else "mod+shift+→"
    return {"system": "mod+u", "arrange": "mod+a", "next": "mod+n",
            "prev": "mod+p", "dive": "pinch out"}.get(cmd, "")


_SAY = []


def say(text):
    """What the footer should read instead of the bare command — for the
    moments when the command is not the lesson, e.g. a goto that framed the
    district and wants you to know the same key again drops you in."""
    _SAY[:] = [text]


def footer(text):
    """Put one line in the strip along the bottom.

    The footer is a file the bar reads, so writing to it is the whole of
    speaking here — and every caller wants the same thing when the write
    fails, which is to carry on. A desktop that dies because it could not
    narrate itself would be a poor trade.
    """
    try:
        with open(LOG, "w") as f:
            f.write(text)
    except OSError:
        pass


def note(argv):
    if not argv or argv[0] in QUIET:
        return
    if _SAY:
        text = _SAY[0]
    else:
        text = " ".join(argv)
        key = key_of(argv)
        if key:
            text += " · " + key
    footer(text)
    if not os.path.exists(SPOKEN):
        try:
            os.makedirs(STATE, exist_ok=True)
            with open(SPOKEN, "w") as f:
                f.write("sol has spoken; the footer reports instead of teaching\n")
        except OSError:
            pass


def note_failure(action, why):
    """A thing that would not start, said out loud where things get said.

    The ☉ menu's rows run programs this machine may simply not have —
    swaylock on a box without it, `systemctl` under an init that is not
    systemd. Those rows used to fail into silence, which reads exactly like
    a menu that ignored you. The footer is already the place sol reports
    from, so a refusal reports there too, naming the program rather than the
    row: the row said "Lock screen", but what is missing is `swaylock`.
    """
    footer("%s did not start · %s" % (action[0], why.strerror or why))


def first_words():
    """Until the first command ever, the footer teaches instead of reporting.

    A virgin install boots to sol's one always-visible strip saying nothing,
    exactly when its reader knows nothing. This is the covenant-safe answer:
    a static line in space that was empty anyway, gone for good the moment
    the first real command overwrites it.
    """
    if os.path.exists(SPOKEN):
        return ""
    return "mod+/ the keys · mod+e the map · right-click the sky"


def last_run():
    try:
        with open(LOG) as f:
            said = f.read().strip()
        age = time.time() - os.path.getmtime(LOG)
    except OSError:
        return first_words()
    if not said or age > 900:
        return first_words()
    when = ("just now" if age < 5 else "%ds ago" % int(age) if age < 90
            else "%dm ago" % int(age / 60))
    return "%s · %s" % (said, when)


RING = "①②③④⑤⑥⑦⑧"          # a planet, as the key that flies you to it
SUP = "⁰¹²³⁴⁵⁶⁷⁸⁹"          # its tally, small enough to read as a badge
DIMC = "#3b4261"            # an empty planet: present, but not asking for you


def chip(p, n, here):
    """One planet, as a bar segment: its ring, its tally, its colour."""
    badge = "".join(SUP[int(c)] for c in str(n)) if n else ""
    colour = p.colour if (n or p is here) else DIMC
    mark = ' underline="single" underline_color="%s"' % p.colour if p is here else ""
    return '<span foreground="%s"%s>%s%s</span>' % (colour, mark,
                                                    RING[p.n - 1], badge)


def strip_markup(counts, here):
    """The eight planets as one line: where you are, and who is holding what.

    Ordinal rather than spatial, because that is how the system is actually
    used — nobody flies by angle, they fly by number. All eight keep the same
    ring so every digit stays readable; the one you are standing on is
    underlined, the way a Mac marks the selected segment of anything. The
    belt keeps its place in the middle, as the divide it is.
    """
    out = []
    for p in PLANETS:
        out.append(chip(p, counts.get(p.n, 0), here))
        if p.n == 4:
            out.append('<span foreground="#2a2f45">┊</span>')
    return "  ".join(out)


def write_bar(st, place, on_it, n, z):
    counts = census(st)
    here = place if (place and on_it and place is not SUN) else None
    if place is None:
        name, cls, role = "the system", "system", "all eight planets"
    elif not on_it:
        name, cls, role = "deep space", "space", "between worlds"
    else:
        name, cls, role = place.name, place.name.lower(), place.role

    # The 12 + N split is a fact about one planet's grid, so it only reads
    # that way when you are standing on one. "the system · 12 + 7" would be
    # arithmetic about nothing.
    count = held(n) if (place and on_it and place is not SUN) else "%d" % n
    holding = role if not n else "%s · %s" % (role, count)
    # Adrift windows are exactly what this bar exists to prevent going
    # unnoticed, so when there are any, the tally says so where you look.
    lost = len(adrift(st))
    if lost:
        holding += '  ·  <span foreground="#e0af68">%d adrift</span>' % lost
    tally = "  ".join("%d %s · %s" % (p.n, p.name, held(counts[p.n]))
                      for p in PLANETS if counts.get(p.n)) or "nothing on the canvas"
    hold_tip = windows_word(n) + " · mod+a tidies" if n else role
    if lost:
        hold_tip += " · %d in no district — sol gather brings them home" % lost
    lines = [
        {"text": name, "class": cls,
         "tooltip": "%s — %d%% · mod+u for the whole system" % (role, int(z * 100))},
        {"text": holding, "class": cls, "tooltip": hold_tip},
        {"text": strip_markup(counts, here), "class": "strip", "tooltip": tally},
        {"text": last_run(), "class": "last", "tooltip": "what sol last did"},
    ]
    for p in PLANETS:
        c = counts.get(p.n, 0)
        lines.append({"text": chip(p, c, here), "class": "chip",
                      "tooltip": "%d %s — %s%s · mod+%d" % (p.n, p.name, p.role,
                                                            " · %d" % c if c else "",
                                                            p.n)})
    text = "\n".join(json.dumps(o) for o in lines) + "\n"
    return text, write_if_changed(BAR, text)


def cmd_bar(args):
    """One line of the bar, straight from the file `sol here` leaves."""
    part = args[0] if args else "where"
    if part not in BAR_PARTS:
        sys.exit("sol bar: %s (want one of: %s)" % (part, ", ".join(BAR_PARTS)))
    try:
        with open(BAR) as f:
            print(f.read().split("\n")[BAR_PARTS.index(part)])
    except (OSError, IndexError):
        print(json.dumps({"text": "", "class": "space"}))


def cmd_here(args):
    d = Drift()
    st = d.state()
    z = d.zoom()
    place, on_it, n = whereabouts(st, d.camera(), z)
    write_plates(st)          # the heartbeat that keeps the name plates current
    bar, _ = write_bar(st, place, on_it, n, z)

    if place is None:
        role, label = "all eight planets", "the system"
    elif not on_it:
        role, label = "between worlds", "deep space"
    else:
        role = place.role
        label = place.name if place is SUN else "%d %s" % (place.n, place.name)

    if "--waybar" in args:
        print(bar.split("\n")[0])
    else:
        print("%s  (%s)%s" % (label, role, "  ·  " + windows_word(n) if n else ""))


def cmd_list(args):
    d = Drift()
    st = d.state()
    total = len(real_windows(st))
    for p in PLACES:
        wins = district(st, p)
        if not wins:
            continue
        head = p.name if p is SUN else "%d %s" % (p.n, p.name)
        print("%-12s %-9s %d" % (head, p.role, len(wins)))
        for w in wins:
            print("    %-18s %s" % (str(w.get("app_id"))[:18], w.get("title", "")[:44]))
    lost = adrift(st)
    if lost:
        print("%-12s %-9s %d" % ("deep space", "adrift", len(lost)))
        for w in lost:
            x, y = w["position"]
            print("    %-18s %-32s (%d, %d)" % (str(w.get("app_id"))[:18],
                                                w.get("title", "")[:32], x, y))
        print("    sol gather brings them to the Sun")
    if not total:
        print("no windows on the canvas")


def cmd_prompt(args):
    """The footer's other half: type any sol command, with completion.

    The bar along the bottom is a status line until you ask it a question.
    This is what runs when you do — a real command line over the same CLI
    everything else already goes through, so there is nothing here that the
    keybindings can do and it cannot. A bare place name is taken as `goto`,
    because "jupiter" is what you would type if nobody had told you a verb
    was expected.
    """
    words = sorted(CMDS) + [p.name.lower() for p in PLACES] + \
        [p.role for p in PLACES] + [str(p.n) for p in PLANETS]
    try:
        import readline

        def complete(text, k):
            hits = [w for w in words if w.startswith(text)]
            return hits[k] if k < len(hits) else None

        readline.set_completer(complete)
        readline.parse_and_bind("tab: complete")
    except ImportError:
        pass                    # a python built without readline: no completion

    sys.stdout.write("\033[?25h")
    sys.stdout.flush()
    try:
        line = input("  \033[38;2;240;217;154m☉\033[0m \033[38;2;86;95;137m▸\033[0m ")
    except (EOFError, KeyboardInterrupt):
        return
    argv = line.split()
    if not argv:
        return
    fn = CMDS.get(argv[0])
    if fn is None and find_place(argv[0]):
        argv = ["goto"] + argv                 # "jupiter" means go to Jupiter
        fn = CMDS["goto"]
    if fn is None:
        # The point of error is the one moment a hint is guaranteed an
        # audience, so a typo answers with the nearest real word.
        import difflib
        near = difflib.get_close_matches(argv[0], words, n=1, cutoff=0.5)
        also = " — %s?" % near[0] if near else ""
        sys.stdout.write("  \033[38;2;247;118;142mno such command: %s\033[0m%s\n"
                         % (argv[0], also))
        sys.stdout.flush()
        time.sleep(2.0 if near else 1.4)
        return
    fn(argv[1:])
    note(argv)


def _pick(items, lines=None):
    """fuzzel, for the switcher — a launcher's job, done by a launcher."""
    import subprocess
    cmd = ["fuzzel", "--dmenu", "--lines", str(lines or len(items))]
    if os.path.exists(FUZZEL):        # ours if it is there, yours if it is not
        cmd += ["--config", FUZZEL]
    try:
        return subprocess.run(cmd, input="\n".join(items), text=True,
                              capture_output=True).stdout.strip()
    except FileNotFoundError:
        sys.exit("sol menu: fuzzel not installed")


def menu_go():
    """The switcher: every place, what it holds, type to filter.

    Centred and modal on purpose — this is alt-tab's job, and alt-tab has
    always appeared in the middle of the screen. It is the context menu that
    must arrive under the pointer, not this.
    """
    counts = census(Drift().state())

    def line(head, key):
        # The key down the right, the way the context menu already does it —
        # the switcher teaches mod+N the same way the menu teaches mod+a.
        return "%s%s%s" % (head, " " * max(2, 38 - len(head)), key)

    items = [line("☉  Sun — home base", "mod+0")]
    for p in PLANETS:
        c = counts.get(p.n, 0)
        items.append(line("%d  %s — %s%s" % (p.n, p.name, p.role,
                                             "  ·  %d" % c if c else ""),
                          "mod+%d" % p.n))
    out = _pick(items)
    if out:
        cmd_goto(["sun" if out.startswith("☉") else out.split()[0]])


# ── The context menu ──────────────────────────────────────────────────────
# The menu itself is `sol-menu`, a layer-shell surface — screen space, where
# a menu belongs. What lives here is only what it says: which place it is
# about, and the rows it offers for that place. See bin/sol-menu for why it
# is no longer a window on the canvas.
def menu_items(here, n, standing):
    """The rows of the context menu for the place under the pointer.

    Shaped like a menu rather than a list — a heading that names what you
    right-clicked, rules between groups, and the keyboard equivalent of each
    item down the right, which is how a menu teaches you to stop needing it.

    Every verb names its place explicitly, because the place under the
    pointer is not necessarily the place you are standing on: pointing at
    Jupiter from the whole-system view and choosing "tidy" must tidy Jupiter,
    not whatever the camera happens to be nearest.
    """
    if here is None:
        title = "the system  ·  all eight planets"
    elif here is SUN:
        title = "Sun  ·  home base"
    else:
        title = "%d %s  ·  %s%s" % (here.n, here.name, here.role,
                                    "  ·  %d" % n if n else "")
    out = [("title", title, "", None), ("sep", "", "", None)]
    if here is not None:
        token = "sun" if here is SUN else str(here.n)
        if not standing:
            # You are pointing at somewhere you are not. Say so first: it is
            # the likeliest thing you meant by pointing at it.
            out.append(("item", "Go to %s" % here.name,
                        "mod+%s" % (0 if here is SUN else here.n),
                        ["sol", "goto", token]))
        if n:
            out.append(("item", "Tidy %s" % ("the Sun" if here is SUN else "this planet"),
                        "mod+a", ["sol", "arrange", token]))
            out.append(("item", "Step through its windows", "mod+n",
                        ["sol", "next", token]))
    out.append(("item", "New terminal here", "mod+⏎", ["foot", "-c", FOOT_INI]))
    out.append(("sep", "", "", None))
    out.append(("item", "Go to a planet…", "mod+tab", ["sol", "menu", "go"]))
    out.append(("item", "Overview", "mod+e", ["sol-map"]))
    out.append(("item", "Whole system", "mod+u", ["sol", "system"]))
    out.append(("item", "Keybindings", "mod+/", ["sol-help"]))
    return out


# ── The system menu ───────────────────────────────────────────────────────
# The bar borrows the shape of the macOS menu bar, and the ☉ at the left end
# of it sits exactly where  does. So it opens what  opens: the operations
# that belong to the machine rather than to anything on it. It drops from the
# bar rather than arriving at the pointer, because that is what a menu-bar
# menu does — the menu belongs to the thing you clicked, and hangs from it.
#
# The commands are systemd's and swaylock's, which is what driftwm runs under
# here. On a machine with something else, this is the only place that knows.
POWER = {
    "lock":     ["swaylock", "-f"],
    "sleep":    ["systemctl", "suspend"],
    "restart":  ["systemctl", "reboot"],
    "shutdown": ["systemctl", "poweroff"],
    "logout":   ["driftwm", "msg", "action", "quit"],
}


def machine():
    """Who and what — the line an About box would carry."""
    who = "%s@%s" % (os.environ.get("USER") or "you", socket.gethostname())
    what = "driftwm"
    try:
        import subprocess
        said = subprocess.run(["driftwm", "--version"], capture_output=True,
                              text=True, timeout=1).stdout.split()
        what = " ".join(said[:2]) or what
    except (OSError, subprocess.SubprocessError):
        pass                    # not on PATH, or too slow to answer: say driftwm
    return "%s  ·  %s" % (who, what)


def system_items():
    """The rows of the ☉ menu: what you do to the machine, not to the canvas.

    Three groups, in the order every desktop has settled on — the ones that
    leave the session running, the ones that take the machine down, and
    leaving. The three that would lose unsaved work end in an ellipsis and
    ask again. The ellipsis means the same thing here it means everywhere
    else, and a menu one click from the corner of the screen has to keep
    that promise: nothing below this line happens on a single misclick.
    """
    return [
        ("title", machine(), "", None),
        ("sep", "", "", None),
        ("item", "Lock screen", "mod+l", POWER["lock"]),
        ("item", "Sleep", "", POWER["sleep"]),
        ("sep", "", "", None),
        ("ask", "Restart…", "", POWER["restart"]),
        ("ask", "Shut down…", "", POWER["shutdown"]),
        ("sep", "", "", None),
        ("ask", "Log out…", "", POWER["logout"]),
    ]


def confirm_items(label, action):
    """The second half of an item that ended in an ellipsis.

    The dangerous answer is named rather than called "OK", so the row you are
    about to click says what it does, and nothing is selected when it opens —
    a return pressed out of habit lands on nothing.
    """
    plain = label.rstrip("…")
    return [
        ("title", "%s?" % plain, "", None),
        ("sep", "", "", None),
        ("item", plain, "", action),
        ("item", "Cancel", "esc", None),
    ]


def cmd_menu(args):
    """Open the context menu at the pointer.

    `go` is the switcher and `system` is the ☉ menu that drops from the bar.
    `here` is the context menu opened from somewhere that is not the canvas —
    the bar — where there is a pointer to open at but no place under it, so
    it describes where you are standing instead of what you clicked on.
    """
    if args and args[0] == "go":
        return menu_go()
    flag = {"system": ["--system"], "here": ["--here"]}.get(args[0] if args else "", [])
    argv = ["sol-menu"] + flag
    try:
        os.execvp("sol-menu", argv)
    except OSError:
        sys.exit("sol menu: sol-menu is not installed")


def cmd_doctor(args):
    """The first ten minutes on someone else's machine, made diagnosable.

    Every check here is a way a fresh install has actually looked broken
    while nothing was wrong with the code: driftwm not up, the config not
    installed, the wrong connector named, the fonts missing so the bar is
    boxes, no touchpad so the flagship gesture is dead air. One paste of
    this output is the whole bug report.
    """
    import shutil
    import subprocess
    OK, WARN, BAD = ("\033[38;2;158;206;106m✓\033[0m",
                     "\033[38;2;224;175;104m!\033[0m",
                     "\033[38;2;247;118;142m✗\033[0m")
    sick = []

    def row(mark, text):
        print("  %s %s" % (mark, text))
        if mark == BAD:
            sick.append(text)

    d = None
    try:
        d = Drift()
        st = d.state()
        out = active_output(st)
        row(OK, "driftwm is up — output %s at %dx%d, zoom %d%%, %d windows"
            % (out.get("name", "?"), *[int(v) for v in (out.get("size") or [0, 0])],
               int((out.get("zoom") or 1) * 100), len(st.get("windows", []))))
    except SystemExit:
        row(BAD, "driftwm is not running (no IPC socket) — start it, then run this again")
        st = {}

    cfg = os.path.expanduser("~/.config/driftwm/config.toml")
    if os.path.exists(cfg):
        row(OK, "config installed at ~/.config/driftwm")
        try:
            with open(cfg) as f:
                text = f.read()
            import re
            named = re.findall(r'^name = "([^"]+)"', text, re.M)
            if d and named and all(o.get("name") not in named
                                   for o in st.get("outputs", []) if o.get("name")):
                have = ", ".join(o.get("name", "?") for o in st.get("outputs", []))
                row(WARN, "[[outputs]] names %s but driftwm sees %s — scale/hot-corner "
                          "rules are not applying" % ("/".join(named), have))
        except OSError:
            pass
    else:
        row(BAD, "no config at ~/.config/driftwm/config.toml — run install.sh")

    try:
        fonts = subprocess.run(["fc-list"], capture_output=True, text=True,
                               timeout=5).stdout.lower()
        row(OK if "jetbrains mono" in fonts else BAD,
            "JetBrains Mono" + ("" if "jetbrains mono" in fonts
                                else " missing — every surface here is set in it"))
        nerd = "nerd font" in fonts or " nf" in fonts or "nerdfont" in fonts
        row(OK if nerd else WARN,
            "a Nerd Font" + ("" if nerd else " missing — the bar's glyphs will be boxes"))
    except (OSError, subprocess.TimeoutExpired):
        row(WARN, "fc-list unavailable — could not check fonts")

    try:
        import gi
        gi.require_version("Gtk", "3.0")
        import ctypes
        ctypes.CDLL("libgtk-layer-shell.so.0")
        row(OK, "GTK 3 + gtk-layer-shell (the ☉ and context menus)")
    except (ImportError, ValueError, OSError):
        row(BAD, "python3-gi or libgtk-layer-shell missing — right-click has nothing to open")

    for cmd_name, why in (("foot", "every terminal surface"), ("waybar", "the bar"),
                          ("fuzzel", "the mod+tab switcher"), ("mako", "notifications"),
                          ("grim", "screenshots")):
        row(OK if shutil.which(cmd_name) else WARN,
            "%s%s" % (cmd_name, "" if shutil.which(cmd_name) else " missing — " + why))

    pad = False
    try:
        for dev in os.listdir("/sys/class/input"):
            name_f = "/sys/class/input/%s/device/name" % dev
            if os.path.exists(name_f):
                with open(name_f) as f:
                    if "touchpad" in f.read().lower():
                        pad = True
                        break
    except OSError:
        pass
    row(OK if pad else WARN,
        "touchpad" + ("" if pad else
                      " not found — the four-finger layer is idle; the bar's "
                      "buttons and the keys do everything it does"))

    # Can this session take the machine down? logind grants that to the active
    # session on a local seat and challenges everyone else, and a challenge
    # with no agent to answer it is a power menu that does nothing when
    # clicked — which looks like a broken menu and is really a broken session.
    # The usual cause is a second desktop still autologging in on another VT,
    # so the count is named too: it is the fix, not just the symptom.
    try:
        import subprocess

        def ask(*argv):
            return subprocess.run(argv, capture_output=True, text=True,
                                  timeout=5).stdout.strip()

        mine = os.environ.get("XDG_SESSION_ID") or ""
        seat = ask("loginctl", "show-session", mine, "-p", "Seat", "--value") if mine else ""
        can = ask("busctl", "call", "org.freedesktop.login1", "/org/freedesktop/login1",
                  "org.freedesktop.login1.Manager", "CanReboot")
        seated = [ln for ln in ask("loginctl", "list-sessions", "--no-legend").splitlines()
                  if " seat" in ln]
        if '"yes"' in can:
            row(OK, "this session may restart and shut down the machine")
        elif not seat:
            # Asked over ssh, where logind challenges anyone without a seat.
            # That answer is about this shell, not about the desktop, so it
            # must not read as a fault — most of this file is worth running
            # remotely, and one honest "cannot tell from here" is cheaper
            # than a red cross that sends you hunting a bug that is not there.
            row(WARN, "asked from a session with no seat (ssh?) — logind challenges "
                      "those whatever the desktop can do, so run this inside sol to "
                      "test the ☉ menu's Restart and Shut down")
        else:
            row(BAD, "logind will not let this session restart the machine — the ☉ "
                     "menu's Restart and Shut down will do nothing. %d seat sessions "
                     "are open; a second desktop left autologging in on another VT "
                     "is the usual reason" % len(seated))
    except (OSError, subprocess.TimeoutExpired):
        row(WARN, "loginctl/busctl unavailable — could not check the power menu")

    # Whether this machine has a way in at all. A desktop you have to start by
    # hand over ssh is the state this file exists to make visible.
    boot = [p for p in (os.path.expanduser("~/.bash_profile"),
                        os.path.expanduser("~/.profile")) if os.path.exists(p)]
    wired = False
    for p in boot:
        try:
            with open(p) as f:
                wired = wired or "sol-session" in f.read()
        except OSError:
            pass
    row(OK if wired else WARN,
        "boots into sol" if wired else
        "nothing starts sol at boot — install.sh can wire the console, or run "
        "`sudo driftwm-up` on a spare VT")
    log = runtime("sol-session.log")
    if os.path.exists(log):
        row(OK, "session log at %s" % log)

    if d:
        lost = adrift(st)
        if lost:
            row(WARN, "%s adrift beyond every district — sol gather brings them home"
                % windows_word(len(lost)))

    if sick:
        sys.exit(1)


HELP = """
   ☉  S O L  —  the canvas is our solar system

   Sun at the centre, planets in the order you already know.
   Distance from the Sun is distance from your attention:
   inner = immediate, the asteroid belt divides, outer = background.

   GO                                  DO
   mod+1 … mod+8   fly to a planet     mod+return   terminal
   mod+0           fly to the Sun      mod+space    launcher
   mod+left/right  sunward / outward   mod+q        close window
   mod+u           whole system view   mod+f        fullscreen
   mod+tab         fly-to menu         mod+m        maximise
   mod+e           the overview        mod+/        this card

   CARRY                               A CROWDED PLANET
   mod+ctrl+1 … 8  send window         mod+a        tidy into a grid
                   to that planet      mod+n/mod+p  step through them
                                       mod+N again  overview, then dive in

   A planet with more windows than fit the screen is framed whole when
   you fly to it; press the same key again to drop into your window.

   mod+e opens the overview: the whole system at a size that resolves,
   every window named, 1…8 to fly and ⏎ to drop into the one you picked.
   mod+; opens the command line in the footer. Drag a window onto another
   planet and it flies itself into that planet's grid.

   THE MOUSE          a number in the bar   click it, you are there
                      ☉ at the far left     lock · sleep · restart · shut down
                      right-click the sky   this place: tidy · terminal · go
                      middle-click the sky  the overview · wheel  zoom

   FOUR FINGERS       swipe ←/→  next planet outward / sunward
                      swipe ↑/↓  the whole system / back to the Sun
                      pinch      out to the system, in to where you are
                      hold       tidy this planet

   1 Mercury quick   3 Earth home    5 Jupiter builds  7 Uranus spare
   2 Venus   comms   4 Mars   ops    6 Saturn  media   8 Neptune archive
"""


def cmd_help(args):
    print(HELP)
    if "--hold" in args:
        try:
            while True:
                time.sleep(3600)
        except KeyboardInterrupt:
            pass


# ── The overview ──────────────────────────────────────────────────────────
# What this replaces was a 40x20 square parked in the corner of every screen.
# At that size the whole system comes to 401 canvas units a cell: neighbouring
# orbits land two cells apart, a district is two rows tall, and there is
# nowhere to say what any window actually is — so it drew the shape of a
# system you already knew by heart and none of what you would open a map for.
#
# It is full screen now, and asked for rather than parked. That buys the
# resolution to draw a district as a rectangle instead of a smear, room to
# name every window in it, and the corner of your screen back.
C_DIM, C_FG, C_CAM = "\033[38;2;65;72;104m", "\033[38;2;192;202;245m", "\033[38;2;125;207;255m"
C_SUN, C_RST = "\033[38;2;224;175;104m", "\033[0m"
C_ORB = "\033[38;2;48;56;84m"       # the orbit hairlines, kept to a whisper
C_KEY = "\033[38;2;86;95;137m"      # the key hints along the bottom
PCOL = {1: "\033[38;2;154;165;206m", 2: "\033[38;2;224;175;104m",
        3: "\033[38;2;122;162;247m", 4: "\033[38;2;247;118;142m",
        5: "\033[38;2;255;158;100m", 6: "\033[38;2;230;207;161m",
        7: "\033[38;2;125;207;255m", 8: "\033[38;2;90;127;208m"}
PCOL[0] = C_SUN

OV_SPAN = SYSTEM_R * 1.10
PANE = 34                           # side pane: what the selected planet holds
TOP = 3                             # the map starts on this terminal row
LEFT = 2                            # ... and in this column


def orbit_points(p, n=200):
    """Points along a planet's real ellipse, with the Sun at a focus."""
    w = math.radians(p.peri)
    cw, sw = math.cos(w), math.sin(w)
    b = p.a * math.sqrt(1 - p.e * p.e)
    cx, cy = -p.a * p.e * cw, -p.a * p.e * sw
    for k in range(n):
        t = 2 * math.pi * k / n
        u, v = p.a * math.cos(t), b * math.sin(t)
        yield cx + u * cw - v * sw, cy + u * sw + v * cw


DOTS = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))


class Sheet:
    """A character grid with a braille layer underneath it.

    Terminal cells are about twice as tall as they are wide, so an orbit
    plotted a whole cell at a time comes out as a flat ellipse in visible
    stair-steps. The dim layer — the orbits and the belt, which are all one
    colour anyway — is plotted into braille instead: eight dots to the cell,
    two across and four down, which lands them on a square sub-pixel and
    draws the ellipses as fine dotted lines rather than a staircase of
    blocks. Everything that carries a colour of its own is drawn over the
    top, a whole cell at a time.
    """

    def __init__(self, w, h, span):
        self.w, self.h, self.span = w, h, span
        self.cell = [[None] * w for _ in range(h)]
        self.sub = [[0] * w for _ in range(h)]

    def col(self, x):
        return int((x + self.span) / (2 * self.span) * self.w)

    def row(self, y):
        return int((self.span - y) / (2 * self.span) * self.h)

    def world(self, c, r):
        x = (c + 0.5) / self.w * 2 * self.span - self.span
        y = self.span - (r + 0.5) / self.h * 2 * self.span
        return x, y

    def dot(self, x, y):
        sx = int((x + self.span) / (2 * self.span) * self.w * 2)
        sy = int((self.span - y) / (2 * self.span) * self.h * 4)
        c, r = sx // 2, sy // 4
        if 0 <= r < self.h and 0 <= c < self.w:
            self.sub[r][c] |= DOTS[sy % 4][sx % 2]

    def free(self, r, c, n):
        """Is there room for n characters at this row and column?"""
        if not (0 <= r < self.h and 0 <= c and c + n <= self.w):
            return False
        return all(self.cell[r][c + i] is None for i in range(n))

    def put(self, x, y, ch, colour):
        c, r = self.col(x), self.row(y)
        if 0 <= r < self.h and 0 <= c < self.w:
            self.cell[r][c] = (ch, colour)
        return r, c

    def text(self, r, c, s, colour):
        for i, ch in enumerate(s):
            if 0 <= r < self.h and 0 <= c + i < self.w:
                self.cell[r][c + i] = (ch, colour)

    def label(self, r, c, s, colour):
        """A planet's name, in the first place beside it that is free.

        Every planet gets named or the overview has not done its job, so this
        works outwards — right of the marker, then left, then the rows below
        and above — and if the whole neighbourhood is taken it writes anyway.
        A name over a district's border edge still reads; a planet with no
        name at all is the one outcome worth avoiding.
        """
        spots = []
        for dr in (0, 1, -1, 2, -2):
            spots += [(r + dr, c + 2), (r + dr, c - len(s) - 1)]
        for rr, cc in spots:
            if self.free(rr, cc, len(s)):
                self.text(rr, cc, s, colour)
                return
        self.text(r, c + 2 if c < self.w // 2 else c - len(s) - 1, s, colour)

    def box(self, x, y, hw, hh, colour):
        """A district's card, as a rounded rectangle."""
        c0, c1 = self.col(x - hw), self.col(x + hw)
        r0, r1 = self.row(y + hh), self.row(y - hh)
        if c1 - c0 < 2 or r1 - r0 < 1:
            return
        for c in range(c0 + 1, c1):
            for r in (r0, r1):
                if 0 <= r < self.h and 0 <= c < self.w:
                    self.cell[r][c] = ("─", colour)
        for r in range(r0 + 1, r1):
            for c in (c0, c1):
                if 0 <= r < self.h and 0 <= c < self.w:
                    self.cell[r][c] = ("│", colour)
        for r, c, ch in ((r0, c0, "╭"), (r0, c1, "╮"), (r1, c0, "╰"), (r1, c1, "╯")):
            if 0 <= r < self.h and 0 <= c < self.w:
                self.cell[r][c] = (ch, colour)

    def lines(self):
        out = []
        for r in range(self.h):
            row = []
            for c in range(self.w):
                got = self.cell[r][c]
                if got:
                    row.append(got[1] + got[0] + C_RST)
                elif self.sub[r][c]:
                    row.append(C_ORB + chr(0x2800 + self.sub[r][c]) + C_RST)
                else:
                    row.append(" ")
            out.append("".join(row))
        return out


def win_name(w):
    """A window, as (what it is, what it is showing).

    The app id is what you sent here and what the rules address; the title is
    whatever it happens to be doing. Both, when they differ — a switcher that
    lists ten identical app ids has told you nothing.
    """
    app = str(w.get("app_id") or "").strip()
    title = (w.get("title") or "").strip()
    if not app:
        return title or "window", ""
    return app, "" if title.lower() in ("", app.lower()) else title


def cell_aspect():
    """How much taller than wide a terminal cell is, asked rather than assumed.

    A cell is roughly 2:1, and "roughly" is what turns a circle into an egg.
    foot reports the window's pixel size alongside its cell counts, so the
    true ratio is there for the asking and the orbits come out round under
    any font. Anything that will not say falls back to the usual 2.2.
    """
    try:
        import fcntl
        import struct
        import termios
        rows, cols, xp, yp = struct.unpack(
            "HHHH", fcntl.ioctl(sys.stdout, termios.TIOCGWINSZ, b"\0" * 8))
        if rows and cols and xp and yp:
            return max(1.2, min(3.5, (yp / rows) / (xp / cols)))
    except (ImportError, OSError, struct.error):
        pass                    # not a tty, or one that will not say: use 2.2
    return 2.2


def draw_overview(d, sel, size):
    """Paint the whole system, and what the selected planet is holding."""
    st = d.state()
    cols, rows = size
    cx, cy = st.get("camera", [0, 0])
    z = st.get("zoom", 1.0) or 1.0
    ow, oh = screen(st)
    counts = census(st)

    mh = max(8, rows - TOP - 3)
    mw = max(20, min(cols - PANE - LEFT - 3, int(mh * cell_aspect())))
    sh = Sheet(mw, mh, OV_SPAN)

    for p in PLANETS:                                   # orbits, then the belt
        for x, y in orbit_points(p, 8 * mw):
            sh.dot(x, y)
    for k in range(2 * mw):
        a = 2 * math.pi * k / (2 * mw)
        sh.dot(BELT_R * math.cos(a), BELT_R * math.sin(a))

    # The viewport, so the overview always says where you are looking.
    hw, hh = ow / (2 * z), oh / (2 * z)
    sh.box(cx, cy, min(hw, sh.span), min(hh, sh.span), C_CAM)

    here, on_it, _ = whereabouts(st, (cx, cy), z)
    marks = []
    for p in PLACES:
        wins = district(st, p)
        if wins:                                        # the card, then its windows
            b = bounds(st, p)
            if b:
                sh.box(b[0], b[1], b[2], b[3], C_DIM)
            for w in wins:
                sh.put(w["position"][0], w["position"][1], "▪", PCOL[p.n])
        lit = PCOL[p.n] + ("\033[1m" if counts.get(p.n) else "")
        r, c = sh.put(p.x, p.y, "☉" if p is SUN else str(p.n), lit)
        marks.append((p, r, c, lit))

    # The names go on last, so each can see where the others landed. The Sun
    # keeps only its glyph: it is the one body nobody has to be told.
    for p, r, c, lit in marks:
        if p is SUN:
            continue
        tag = "%s·%d" % (p.name, counts[p.n]) if counts.get(p.n) else p.name
        sh.label(r, c, ("▸" + tag) if p is sel[0] else tag, lit)

    body = sh.lines()

    # ── the side pane: what the selected planet is holding ──
    p = sel[0]
    wins = district(st, p)
    head = p.name if p is SUN else "%d %s" % (p.n, p.name)
    pane = [PCOL[p.n] + "\033[1m" + head.upper() + C_RST,
            C_DIM + "%s · %s" % (p.role, windows_word(len(wins)) if wins
                                 else "empty") + C_RST, ""]
    for i, w in enumerate(wins[:mh - 4]):
        app, title = win_name(w)
        app = app[:14]
        row = "%-15s%s" % (app, title[:PANE - 18])
        if i == sel[1]:
            pane.append(PCOL[p.n] + "▸ " + row + C_RST)
        else:
            pane.append(C_FG + "  " + app.ljust(15) + C_RST
                        + C_DIM + title[:PANE - 18] + C_RST)
    if len(wins) > mh - 4:
        pane.append(C_DIM + "  … and %d more" % (len(wins) - (mh - 4)) + C_RST)

    where = ("the system" if here is None else "deep space" if not on_it
             else here.name if here is SUN else "%d %s" % (here.n, here.name))
    head = " ☉  S O L" + "   " + C_DIM + where + " · " + \
        windows_word(len(real_windows(st))) + " · %d%%" % int(z * 100) + C_RST
    keys = ("1…8 fly  ·  ↑↓ pick  ·  ⏎ dive in  ·  a tidy  ·  "
            "u system  ·  click anywhere  ·  esc")

    buf = ["\033[H", C_FG + head + C_RST + "\033[K\n\033[K\n"]
    for i in range(mh):
        buf.append(" " * LEFT + body[i])
        if i < len(pane):
            buf.append("  " + pane[i])
        buf.append("\033[K\n")
    buf.append("\033[K\n" + " " * LEFT + C_KEY + keys + C_RST + "\033[K")
    sys.stdout.write("".join(buf))
    sys.stdout.flush()
    return sh, st


def next_key(buf):
    """Pull one keystroke off the front of the buffer.

    Returns (key, rest), or (None, buf) when the buffer holds the start of an
    escape sequence whose tail has not arrived yet. Keys have to be parsed out
    of a buffer rather than read one byte at a time because an arrow key is
    three bytes that arrive together: read them through a buffered stream and
    select() — which watches the file descriptor, not Python's buffer — will
    say there is nothing more to come, and the tail of the sequence is thrown
    away. So the reading is raw, and the framing happens here.
    """
    if not buf.startswith("\033"):
        return buf[0], buf[1:]
    if len(buf) == 1:
        return None, buf                       # ESC alone, or the start of more
    if buf[1] != "[":
        return buf[:2], buf[2:]
    if buf.startswith("\033[<"):               # an SGR mouse report
        for i in range(3, len(buf)):
            if buf[i] in "Mm":
                return buf[:i + 1], buf[i + 1:]
        return (None, buf) if len(buf) < 32 else ("", "")
    for i in range(2, len(buf)):               # any other CSI: ends on a final
        if "@" <= buf[i] <= "~":
            return buf[:i + 1], buf[i + 1:]
    return None, buf


def cmd_map(args):
    """The overview — the whole system, named, on demand.

    Opened and closed with mod+e (or the ▦ in the bar). Because it is a
    window like any other, closing it costs nothing to remember: the process
    ends and the screen is yours again.
    """
    d = Drift()
    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    try:
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)
    except (termios.error, OSError):
        old = None              # stdin is not a terminal: draw once, read nothing
    sys.stdout.write("\033[?1049h\033[?25l\033[2J\033[?1006h\033[?1000h")

    st0 = d.state()
    at, _, _ = whereabouts(st0, d.camera(), d.zoom())
    sel = [at if at else SUN, 0]
    sh, st = None, st0
    buf, last = "", 0.0
    try:
        while True:
            if time.time() - last > 0.5:
                try:
                    size = os.get_terminal_size()
                    size = (size.columns, size.lines)
                except OSError:
                    size = (120, 40)
                sh, st = draw_overview(d, sel, size)
                last = time.time()

            r, _, _ = select.select([sys.stdin], [], [], 0.12)
            if not r:
                if buf == "\033":              # Esc, with nothing following it
                    return
                buf = ""
                continue
            try:
                chunk = os.read(fd, 64).decode("utf-8", "ignore")
            except OSError:
                return
            if not chunk:                      # stdin closed under us
                return
            buf += chunk

            while buf:
                key, rest = next_key(buf)
                if key is None:                # a sequence still arriving
                    break
                buf = rest
                if key.startswith("\033[<"):
                    if not click(d, st, sh, sel, key):
                        return
                    last = 0
                    continue
                if not step_key(d, st, sel, key):
                    return
                last = 0
    except KeyboardInterrupt:
        pass
    finally:
        if old:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?1000l\033[?1006l\033[?25h\033[?1049l")


def step_key(d, st, sel, key):
    """Act on one keystroke. False means the overview is done."""
    wins = district(st, sel[0])
    if key in ("q", "\033"):
        return False
    if key in ("\033[A", "k"):
        sel[1] = max(0, sel[1] - 1)
    elif key in ("\033[B", "j"):
        sel[1] = min(max(0, len(wins) - 1), sel[1] + 1)
    elif key in ("\033[D", "h", "\033[C", "l"):
        step = -1 if key in ("\033[D", "h") else 1
        sel[0] = PLACES[(PLACES.index(sel[0]) + step) % len(PLACES)]
        sel[1] = 0
    elif len(key) == 1 and key in "012345678":
        sel[0], sel[1] = PLACES[int(key)], 0
        fly(d, *frame(st, sel[0], screen(st)))
    elif key == "u":
        cmd_system([])
        sel[0] = SUN
    elif key == "a":
        cmd_arrange([str(sel[0].n)])
    elif key in ("\r", "\n"):
        if wins:
            dive(d, st, wins[min(sel[1], len(wins) - 1)])
            return False
    return True


def click(d, st, sh, sel, seq):
    """Act on one mouse report. False means the overview is done.

    Clicking the map flies you there — and clicking the cell a planet is
    drawn in means that planet, so the click lands on something meaningful
    rather than a point in empty space near it. Clicking a row of the side
    pane goes all the way: that window, focused, with the view on it.
    """
    try:
        btn, col, row = (int(v) for v in seq[3:-1].split(";"))
    except ValueError:
        return True
    if not seq.endswith("M") or btn != 0 or sh is None:
        return True
    c, r = col - 1 - LEFT, row - TOP
    if 0 <= r < sh.h and 0 <= c < sh.w:
        hit = next((q for q in PLACES if (sh.row(q.y), sh.col(q.x)) == (r, c)), None)
        if hit:
            sel[0], sel[1] = hit, 0
            fly(d, *frame(st, hit, screen(st)))
        else:
            fly(d, *sh.world(c, r), z_or(d, 0.5))
    elif c >= sh.w:
        i = r - 3                              # the pane's list starts here
        wins = district(st, sel[0])
        if 0 <= i < len(wins):
            sel[1] = i
            dive(d, st, wins[i])
            return False
    return True


def z_or(d, floor):
    """Keep the zoom you had when clicking empty space, unless you are far out."""
    z = d.zoom()
    return z if z >= floor else 1.0


def dive(d, st, w):
    """Focus a window, bring it forward, and fly to it."""
    d.focus(w["id"])
    spotlight(d, st, w["id"])
    fly(d, w["position"][0], w["position"][1], WORK_ZOOM)


# ── Entry ─────────────────────────────────────────────────────────────────
CMDS = {"goto": cmd_goto, "hop": cmd_hop, "dive": cmd_dive, "system": cmd_system, "send": cmd_send,
        "here": cmd_here, "menu": cmd_menu, "map": cmd_map, "help": cmd_help,
        "arrange": cmd_arrange, "list": cmd_list, "plate": cmd_plate, "bar": cmd_bar,
        "watch": cmd_watch, "prompt": cmd_prompt,
        "gather": cmd_gather, "sweep": cmd_sweep, "tour": cmd_tour,
        "doctor": cmd_doctor, "first-light": cmd_first_light,
        "shift": lambda a: cmd_shift(a, -1 if a and a[0].startswith("b") else 1),
        "next": lambda a: cmd_step(a, 1), "prev": lambda a: cmd_step(a, -1)}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(HELP)
        print("  commands: " + "  ".join(sorted(CMDS)))
        return
    cmd = sys.argv[1]
    if cmd == "fly":
        d = Drift()
        a = sys.argv[2:]
        fly(d, float(a[0]), float(a[1]), float(a[2]) if len(a) > 2 else WORK_ZOOM)
        return
    fn = CMDS.get(cmd)
    if not fn:
        sys.exit("sol: unknown command '%s' (try: %s)" % (cmd, ", ".join(sorted(CMDS))))
    fn(sys.argv[2:])
    note(sys.argv[1:])       # the footer says what just happened


if __name__ == "__main__":
    main()
