#!/usr/bin/env python3
# sol-spin — circle-gesture daemon + input-activity stamp (opt-in extra).
# Draw a circle with the mouse (no buttons held): clockwise travels outward
# through the solar system, counter-clockwise travels sunward — the same hop
# as mod+left / mod+right, via `sol hop`.
# Reads raw relative motion from /dev/input (needs root / input group).
#
# It also stamps ACTIVITY_FILE on any key/pointer/touch event (rate-limited),
# which is how sol-planetarium tells real idleness from you simply not
# panning the camera.

import glob
import math
import os
import select
import struct
import subprocess
import time

EVFMT = 'llHHi'
EVSZ = struct.calcsize(EVFMT)
EV_KEY, EV_REL, EV_ABS = 0x01, 0x02, 0x03
REL_X, REL_Y = 0, 1
BTNS = {272, 273, 274}  # BTN_LEFT, BTN_RIGHT, BTN_MIDDLE

ACTIVITY_FILE = os.environ.get('SOL_ACTIVITY', '/tmp/sol-activity')
ACTIVITY_PERIOD = 1.0   # s between stamps

TURN_RAD = 5.8      # ~0.92 of a full circle
MIN_PATH = 280.0    # px of travel
MAX_SPAN = 2.0      # s to complete the circle
IDLE_RESET = 0.4    # s without motion resets the gesture
COOLDOWN = 0.8      # s after firing


def pointer_devices():
    """(pointer devices usable for the circle gesture, all input devices)"""
    pointers, every = [], []
    try:
        blocks = open('/proc/bus/input/devices').read().split('\n\n')
    except OSError:
        return pointers, every
    for b in blocks:
        rel = None
        ev = None
        for line in b.splitlines():
            if line.startswith('B: REL='):
                rel = int(line.split('=')[1].split()[0], 16)
            if line.startswith('H: Handlers=') and 'event' in line:
                for tok in line.split():
                    if tok.startswith('event'):
                        ev = tok
        if not ev:
            continue
        path = '/dev/input/' + ev
        every.append(path)
        if rel is not None and (rel & 0x3) == 0x3:
            pointers.append(path)
    return pointers, every


def stamp_activity():
    """Mark 'the user is present' for driftwm-planetarium."""
    try:
        with open(ACTIVITY_FILE, 'a'):
            pass
        os.utime(ACTIVITY_FILE, None)
        os.chmod(ACTIVITY_FILE, 0o666)
    except OSError:
        pass


def fire(direction):
    socks = glob.glob('/run/user/*/driftwm/ipc-*.sock')
    if not socks:
        return
    env = dict(os.environ)
    env['DRIFTWM_SOCKET'] = socks[0]
    env['XDG_RUNTIME_DIR'] = os.path.dirname(os.path.dirname(socks[0]))
    subprocess.Popen(['/usr/local/bin/sol', 'hop', direction], env=env,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    pointers, every = pointer_devices()
    fds = {}
    for d in every:
        try:
            fd = os.open(d, os.O_RDONLY | os.O_NONBLOCK)
            fds[fd] = d in pointers   # True = drives the circle gesture
        except OSError:
            pass
    if not fds:
        time.sleep(5)
        return

    dx = dy = 0
    prev_heading = None
    turn = path = 0.0
    start = last_motion = 0.0
    buttons = 0
    quiet_until = 0.0
    last_stamp = 0.0

    def reset():
        nonlocal prev_heading, turn, path, start
        prev_heading = None
        turn = path = 0.0
        start = 0.0

    while True:
        r, _, _ = select.select(list(fds), [], [], 0.03)
        now = time.monotonic()
        for fd in r:
            is_pointer = fds.get(fd, False)
            try:
                data = os.read(fd, EVSZ * 64)
            except OSError:
                os.close(fd)
                fds.pop(fd, None)
                if not fds:
                    return
                continue
            for off in range(0, len(data) - EVSZ + 1, EVSZ):
                _, _, etype, code, value = struct.unpack_from(EVFMT, data, off)
                if etype in (EV_KEY, EV_REL, EV_ABS) and now - last_stamp > ACTIVITY_PERIOD:
                    stamp_activity()
                    last_stamp = now
                if not is_pointer:
                    continue
                if etype == EV_REL:
                    if code == REL_X:
                        dx += value
                    elif code == REL_Y:
                        dy += value
                elif etype == EV_KEY and code in BTNS:
                    buttons += 1 if value == 1 else (-1 if value == 0 else 0)
                    buttons = max(buttons, 0)

        if buttons > 0 or now < quiet_until:
            dx = dy = 0
            reset()
            continue

        step = math.hypot(dx, dy)
        if step >= 4.0:
            heading = math.atan2(dy, dx)
            if prev_heading is not None:
                d = heading - prev_heading
                while d > math.pi:
                    d -= 2 * math.pi
                while d < -math.pi:
                    d += 2 * math.pi
                if turn != 0.0 and d * turn < 0 and abs(d) > 0.6:
                    reset()
                    heading = math.atan2(dy, dx)
                else:
                    turn += d
                    path += step
            else:
                start = now
                path += step
            prev_heading = heading
            last_motion = now
            dx = dy = 0
        elif last_motion and now - last_motion > IDLE_RESET:
            reset()

        if start and now - start > MAX_SPAN:
            reset()

        if abs(turn) >= TURN_RAD and path >= MIN_PATH:
            # screen coords are y-down: positive turn = visually clockwise
            # screen coords are y-down, so a positive turn is visually clockwise
            fire('out' if turn > 0 else 'in')
            quiet_until = now + COOLDOWN
            reset()


if __name__ == '__main__':
    while True:
        try:
            main()
        except Exception:
            time.sleep(3)
